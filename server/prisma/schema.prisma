generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum EmailStatus {
  SENT
  FAILED
}

enum AppStatus {
  IDLE
  DEPLOYING
  RUNNING
  STOPPED
  FAILED
}

enum AppKind {
  NODE
  AI
}

enum AiStatus {
  IDLE
  GENERATING
  FAILED
}

enum TokenPurchaseStatus {
  PENDING
  PAID
}

enum DomainStatus {
  PENDING
  ACTIVE
  FAILED
}

enum DeploymentStep {
  QUEUED
  PREPARING
  INSTALLING
  BUILDING
  STARTING
  ROUTING
  DONE
}

enum DeploymentStatus {
  QUEUED
  BUILDING
  RUNNING
  FAILED
  SUPERSEDED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  password     String
  name         String
  role         Role      @default(USER)
  verified     Boolean   @default(false)
  blocked      Boolean   @default(false)
  verifyCodeHash    String?
  verifyCodeExpires DateTime?
  verifyCodeSentAt  DateTime?
  verifyAttempts    Int       @default(0)
  resetToken   String?
  resetExpires DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tokenBalance    Int     @default(0)
  freeAiAppUsed   Boolean @default(false)
  freeAiBuildUsed Boolean @default(false)

  apps           App[]
  projectMembers ProjectMember[]
  sentInvites    ProjectInvite[]
  tokenPurchases TokenPurchase[]
  tokenUsages    TokenUsage[]

  @@map("users")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   App      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model ProjectInvite {
  id          String   @id @default(cuid())
  projectId   String
  project     App      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  email       String
  token       String   @unique
  invitedById String
  invitedBy   User     @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([projectId, email])
  @@map("project_invites")
}

model ApiKey {
  id         String    @id @default(cuid())
  projectId  String
  project    App       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  prefix     String
  hash       String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([projectId])
  @@map("api_keys")
}

model Bucket {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   App      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  minioName String   @unique
  accessKey String   @unique
  secretKey String
  createdAt DateTime @default(now())
  aiApps    App[]    @relation("AiAppBucket")

  @@map("buckets")
}

model Database {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   App      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  dbName    String   @unique
  roleName  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  aiApps    App[]    @relation("AiAppDatabase")

  @@map("databases")
}

model EmailSender {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   App      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  username  String   @unique
  createdAt DateTime @default(now())

  @@map("email_senders")
}

model EmailLog {
  id        String      @id @default(cuid())
  projectId String
  project   App         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  from      String
  to        String[]
  subject   String
  status    EmailStatus
  resendId  String?
  error     String?
  createdAt DateTime    @default(now())

  @@index([projectId, createdAt])
  @@map("email_logs")
}

model App {
  parentProjectId String?
  parentProject   App?            @relation("ProjectApps", fields: [parentProjectId], references: [id], onDelete: Cascade)
  projectApps     App[]           @relation("ProjectApps")
  appName         String?
  appEnabled      Boolean         @default(true)
  deleting        Boolean         @default(false)
  schedules       Schedule[]
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  slug            String          @unique
  env             Json            @default("{}")
  nodeVersion     String?
  rootDir         String?
  installCommand  String?
  buildCommand    String?
  startCommand    String?
  status          AppStatus       @default(IDLE)
  containerId     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deployments     Deployment[]
  domains         AppDomain[]
  apiKeys         ApiKey[]
  bucket          Bucket?
  database        Database?
  emailLogs       EmailLog[]
  emailSender     EmailSender?
  members         ProjectMember[]
  invites         ProjectInvite[]
  kind            AppKind         @default(NODE)
  aiStatus        AiStatus        @default(IDLE)
  aiProgress      String?
  aiError         String?
  aiAuthSecret    String?
  aiSteps         Json            @default("[]")
  aiDatabaseId    String?
  aiDatabase      Database?       @relation("AiAppDatabase", fields: [aiDatabaseId], references: [id], onDelete: SetNull)
  aiBucketId      String?
  aiTheme         String?
  aiBucket        Bucket?         @relation("AiAppBucket", fields: [aiBucketId], references: [id], onDelete: SetNull)
  aiMessages      AiMessage[]
  tokenUsages     TokenUsage[]

  @@index([parentProjectId])
  @@map("apps")
}

model AppDomain {
  id               String       @id @default(cuid())
  appId            String
  app              App          @relation(fields: [appId], references: [id], onDelete: Cascade)
  hostname         String       @unique
  status           DomainStatus @default(PENDING)
  error            String?
  npmProxyHostId   Int?
  npmCertificateId Int?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([appId])
  @@map("app_domains")
}

model Deployment {
  id          String           @id @default(cuid())
  appId       String
  app         App              @relation(fields: [appId], references: [id], onDelete: Cascade)
  status      DeploymentStatus @default(QUEUED)
  step        DeploymentStep   @default(QUEUED)
  artifactKey String
  imageTag    String?
  log         String           @default("")
  createdAt   DateTime         @default(now())
  finishedAt  DateTime?

  @@index([appId, createdAt])
  @@map("deployments")
}

model Schedule {
  id              String        @id @default(cuid())
  projectId       String
  project         App           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  url             String
  method          String        @default("GET")
  headers         Json          @default("{}")
  body            String?
  intervalMinutes Int
  enabled         Boolean       @default(true)
  nextRunAt       DateTime
  lockedUntil     DateTime?
  lockToken       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  runs            ScheduleRun[]

  @@index([enabled, nextRunAt])
  @@index([projectId])
  @@map("schedules")
}

model ScheduleRun {
  id         String   @id @default(cuid())
  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  startedAt  DateTime
  finishedAt DateTime
  statusCode Int?
  error      String?
  durationMs Int

  @@index([scheduleId, startedAt])
  @@map("schedule_runs")
}

model AiMessage {
  id        String   @id @default(cuid())
  appId     String
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  role      String
  content   String   @db.Text
  steps     Json     @default("[]")
  createdAt DateTime @default(now())

  @@index([appId, createdAt])
  @@map("ai_messages")
}

model TokenPurchase {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens       Int
  amountCents  Int
  status       TokenPurchaseStatus @default(PENDING)
  lsCheckoutId String?             @unique
  lsOrderId    String?             @unique
  lsEventId    String?             @unique
  paidAt       DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([userId, status, createdAt])
  @@map("token_purchases")
}

model TokenUsage {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appId             String?
  app               App?     @relation(fields: [appId], references: [id], onDelete: SetNull)
  appName           String
  free              Boolean  @default(false)
  tokens            Int      @default(0)
  inputTokens       Int      @default(0)
  cachedInputTokens Int      @default(0)
  outputTokens      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, createdAt])
  @@map("token_usages")
}
