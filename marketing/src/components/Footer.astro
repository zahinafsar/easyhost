---
import { FOOTER_COLUMNS, FOOTER_LEGAL } from "../seo/site.mjs";
import Logo from "./ui/Logo.astro";
import Button from "./ui/Button.astro";
import CopyLine from "./ui/CopyLine.astro";

interface Props {
  cta?: boolean;
  title?: string;
  text?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
}

const {
  cta = true,
  title = "Your agent wrote the app. Let it ship it.",
  text = "Install the skill with one command, then deploy with one sentence. Postgres, S3 storage and HTTPS come with every project.",
  primary = { label: "Get started", href: "/docs#quick-start" },
  secondary = { label: "Sign up", href: "https://app.reverhost.com/register" },
} = Astro.props;
const hasTitle = Astro.slots.has("title");
---

<footer class="footer">
  <div class="container container-xl">
    <div class="footer-block">
      {cta && (
        <div class="footer-cta">
          <div class="footer-cta-main">
            {hasTitle && <h2 class="footer-cta-title"><slot name="title" /></h2>}
            {!hasTitle && <h2 class="footer-cta-title">{title}</h2>}
          </div>
          <div class="footer-cta-side">
            <p class="footer-cta-text">{text}</p>
            <div class="footer-cta-actions">
              <Button href={secondary.href} variant="ghost-inverse">{secondary.label}</Button>
              <Button href={primary.href} variant="dark-inverse" size="lg">{primary.label}</Button>
            </div>
          </div>
        </div>
      )}
      <nav class="footer-columns" aria-label="Footer">
        {
          FOOTER_COLUMNS.map((column) => (
            <div class="footer-column">
              <p class="footer-title">{column.title}</p>
              <ul>
                {column.links.map(([href, label]) => (
                  <li>
                    <a href={href}>{label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
      <p class="footer-wordmark" aria-hidden="true">Reverhost</p>
      <div class="footer-bottom">
        <div class="footer-brand">
          <Logo tone="light" />
          <span class="footer-tagline">Free app hosting in any language with Postgres and S3 storage, built for AI coding agents. No credit card.</span>
        </div>
        <span class="footer-copy">&copy; 2026 Reverhost</span>
        <CopyLine command="npx ezhst skill install" tone="dark" />
        <a class="footer-credit" href="https://www.pexels.com" target="_blank" rel="noopener noreferrer">Photos from Pexels</a>
      </div>
      <nav class="footer-legal" aria-label="Legal">
        {FOOTER_LEGAL.map(([href, label]) => <a href={href}>{label}</a>)}
      </nav>
    </div>
  </div>
</footer>
