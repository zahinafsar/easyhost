---
interface Props {
  docs?: boolean;
  login?: boolean;
}

const { docs = false, login = true } = Astro.props;
---

<header class="nav">
  <div class="container nav-inner">
    <a href="/" class="logo">
      <img src="/logo.svg" alt="" width="18" height="24" />
      Reverhost
      <span class="beta">Beta</span>
      {docs && <small>docs</small>}
    </a>
    <nav class="nav-links" aria-label="Main">
      <slot />
    </nav>
    <div class="nav-actions">
      {login && <a href="https://app.reverhost.com/login" class="btn btn-ghost">Log in</a>}
      <a href="https://app.reverhost.com/register" class="btn btn-primary">Sign up</a>
    </div>
  </div>
</header>
