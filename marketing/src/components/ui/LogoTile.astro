---
interface Props {
  name: string;
  src?: string;
  meta?: string;
  href?: string;
  external?: boolean;
  class?: string;
}

const { name, src, meta, href, external = true, class: className } = Astro.props;
let Tag = "div";
if (href) {
  Tag = "a";
}
let target: string | undefined;
let rel: string | undefined;
if (href && external) {
  target = "_blank";
  rel = "noreferrer";
}
---

<Tag href={href} target={target} rel={rel} class:list={["logo-tile", href && "logo-tile-link", className]}>
  {src && (
    <span class="logo-tile-mark">
      <img src={src} alt="" width="28" height="28" loading="lazy" decoding="async" />
    </span>
  )}
  <span class="logo-tile-text">
    <strong>{name}</strong>
    {meta && <small>{meta}</small>}
  </span>
</Tag>
