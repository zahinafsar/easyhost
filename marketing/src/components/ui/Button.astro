---
import Icon from "./Icon.astro";

interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost" | "dark-inverse" | "ghost-inverse";
  size?: "sm" | "md" | "lg";
  icon?: string;
  iconRight?: string;
  external?: boolean;
  block?: boolean;
  type?: "button" | "submit";
  label?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = "primary",
  size = "md",
  icon,
  iconRight,
  external = false,
  block = false,
  type = "button",
  label,
  class: className,
  ...rest
} = Astro.props;

const classes = ["btn", `btn-${variant}`, `btn-${size}`, block && "btn-block", className];
let iconSize = 16;
if (size === "sm") {
  iconSize = 14;
}
let target: string | undefined;
let rel: string | undefined;
if (external) {
  target = "_blank";
  rel = "noopener noreferrer";
}
---

{
  href && (
    <a href={href} class:list={classes} target={target} rel={rel} aria-label={label} {...rest}>
      {icon && <Icon name={icon} size={iconSize} />}
      <span class="btn-label"><slot /></span>
      {iconRight && <Icon name={iconRight} size={iconSize} />}
    </a>
  )
}
{
  !href && (
    <button type={type} class:list={classes} aria-label={label} {...rest}>
      {icon && <Icon name={icon} size={iconSize} />}
      <span class="btn-label"><slot /></span>
      {iconRight && <Icon name={iconRight} size={iconSize} />}
    </button>
  )
}
