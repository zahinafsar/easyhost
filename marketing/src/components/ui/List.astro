---
interface Props {
  as?: "ul" | "ol";
  marker?: "check" | "dot" | "x" | "none";
  gap?: "sm" | "md" | "lg";
  size?: "sm" | "md";
  tone?: "default" | "inverse";
  divided?: boolean;
  class?: string;
}

const { as: Tag = "ul", marker = "check", gap = "sm", size = "md", tone = "default", divided = false, class: className } = Astro.props;
---

<Tag class:list={["list", `list-${marker}`, `list-gap-${gap}`, `list-${size}`, `list-tone-${tone}`, divided && "list-divided", className]}>
  <slot />
</Tag>
