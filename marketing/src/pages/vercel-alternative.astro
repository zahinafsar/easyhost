---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import StartCta from "../components/ui/StartCta.astro";
import NavLink from "../components/ui/NavLink.astro";
import Section from "../components/ui/Section.astro";
import Frame from "../components/ui/Frame.astro";
import Stack from "../components/ui/Stack.astro";
import Grid from "../components/ui/Grid.astro";
import Box from "../components/ui/Box.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
import Heading from "../components/ui/Heading.astro";
import Accent from "../components/ui/Accent.astro";
import Text from "../components/ui/Text.astro";
import Link from "../components/ui/Link.astro";
import InlineCode from "../components/ui/InlineCode.astro";
import Button from "../components/ui/Button.astro";
import DocLayout from "../components/ui/DocLayout.astro";
import Toc from "../components/ui/Toc.astro";
import Table from "../components/ui/Table.astro";
import Row from "../components/ui/Row.astro";
import Cell from "../components/ui/Cell.astro";
import FeatureCard from "../components/ui/FeatureCard.astro";
import CodeBlock from "../components/ui/CodeBlock.astro";
import List from "../components/ui/List.astro";
import ListItem from "../components/ui/ListItem.astro";
import NumberedList from "../components/ui/NumberedList.astro";
import NumberedItem from "../components/ui/NumberedItem.astro";
import Accordion from "../components/ui/Accordion.astro";
import AccordionItem from "../components/ui/AccordionItem.astro";

const crumbs = [
  { name: "Reverhost", path: "/" },
  { name: "Vercel alternative", path: "/vercel-alternative" },
];

const toc = [
  { href: "#summary", label: "Summary" },
  { href: "#table", label: "Side by side" },
  { href: "#easyhost-fits", label: "When Reverhost fits" },
  { href: "#vercel-fits", label: "When Vercel fits" },
  { href: "#migrate", label: "Moving from Vercel" },
  { href: "#faq", label: "FAQ" },
];

const migrateCode = `vercel env pull .env.production
npx ezhst projects create my-app --link
npx ezhst env import .env.production
npx ezhst build dockerfile template node > Dockerfile
npx ezhst build dockerfile set -f Dockerfile
npx ezhst deploy
npx ezhst domains add www.example.com`;
---

<Base>
  <Fragment slot="head">
    <title>A Free Vercel Alternative for Next.js Apps | Reverhost</title>
    <meta name="description" content="Reverhost is a free Vercel alternative for Next.js: an always-on container with Postgres and S3 storage included. See the honest differences and how to move." />
    <link rel="canonical" href="https://reverhost.com/vercel-alternative" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Reverhost" />
    <meta property="og:url" content="https://reverhost.com/vercel-alternative" />
    <meta property="og:title" content="A Free Vercel Alternative for Next.js Apps | Reverhost" />
    <meta property="og:description" content="A free Vercel alternative for Next.js: an always-on container with Postgres and S3 storage included." />
    <meta property="og:image" content="https://reverhost.com/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://reverhost.com/og.png" />
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "TechArticle",
            "headline": "A free Vercel alternative for Next.js apps",
            "description": "Reverhost is a free Vercel alternative for Next.js: an always-on container with Postgres and S3 storage included. See the honest differences and how to move.",
            "url": "https://reverhost.com/vercel-alternative",
            "image": "https://reverhost.com/og.png",
            "datePublished": "2026-09-30",
            "dateModified": "2026-11-25",
            "author": {
              "@type": "Organization",
              "name": "Reverhost",
              "url": "https://reverhost.com/"
            },
            "publisher": {
              "@type": "Organization",
              "name": "Reverhost",
              "url": "https://reverhost.com/",
              "logo": "https://reverhost.com/icon-512.png"
            },
            "mainEntityOfPage": "https://reverhost.com/vercel-alternative"
          },
          {
            "@type": "BreadcrumbList",
            "itemListElement": [
              {
                "@type": "ListItem",
                "position": 1,
                "name": "Reverhost",
                "item": "https://reverhost.com/"
              },
              {
                "@type": "ListItem",
                "position": 2,
                "name": "Vercel alternative",
                "item": "https://reverhost.com/vercel-alternative"
              }
            ]
          },
          {
            "@type": "FAQPage",
            "mainEntity": [
              {
                "@type": "Question",
                "name": "Is Reverhost a drop-in replacement for Vercel?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "For a standard Next.js app, mostly yes: it builds with next build and runs with next start without changes. Vercel-specific services such as Vercel Blob, vercel.json cron jobs, preview deployments and the edge network do not carry over."
                }
              },
              {
                "@type": "Question",
                "name": "Is Reverhost faster than Vercel?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "It depends on where your visitors are. Reverhost has no cold starts because the container is always on, but it serves from one region. Vercel serves static assets from a global CDN."
                }
              },
              {
                "@type": "Question",
                "name": "Can I keep my custom domain when I move?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Yes. Add it with ezhst domains add, set the DNS record that ezhst domains list shows, then run ezhst domains verify to issue HTTPS."
                }
              }
            ]
          }
        ]
      }
    </script>
  </Fragment>

  <Nav>
    <NavLink href="/">Home</NavLink>
    <NavLink href="/free-nextjs-hosting">Free hosting</NavLink>
    <NavLink href="/vercel-alternative">vs Vercel</NavLink>
    <NavLink href="/docs" keep>Docs</NavLink>
  </Nav>

  <Section size="full" space="none">
    <Frame padding="md">
      <Stack gap="md" align="center">
        <Breadcrumbs items={crumbs} />
        <Heading level={1} size="xl" align="center" maxWidth="820px" reveal={0}>A free <Accent>Vercel alternative</Accent> for Next.js apps</Heading>
        <Text size="lg" tone="muted" align="center" maxWidth="720px" balance reveal={1}>Reverhost is a free place to run a Next.js app when you want a plain always-on server with a database and file storage already attached. Vercel is the better choice when you need a global CDN, preview deployments or Git-based workflows. This page lays out the differences so you can pick.</Text>
        <Stack direction="row" gap="sm" wrap justify="center" reveal={2}>
          <Button href="#table" size="lg" icon="layers">Compare side by side</Button>
          <Button href="#migrate" variant="secondary" size="lg">Moving from Vercel</Button>
        </Stack>
        <Text size="sm" tone="subtle" align="center">Last updated November 25, 2026</Text>
      </Stack>
    </Frame>
  </Section>

  <DocLayout>
    <Toc slot="aside" items={toc} />

    <Box as="section" id="summary" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">The summary</Heading>
        <Grid cols={2} gap="sm">
          <FeatureCard title="Runtime" icon="server" variant="frosted">
            <Text size="sm" tone="muted">Vercel splits your app into serverless functions behind a CDN. Reverhost runs <InlineCode>next start</InlineCode> in one container that stays up.</Text>
          </FeatureCard>
          <FeatureCard title="Backend" icon="database" iconTone="green" variant="frosted">
            <Text size="sm" tone="muted">Reverhost includes Postgres and S3 compatible storage in the free account. On Vercel Hobby, a database comes from another provider.</Text>
          </FeatureCard>
          <FeatureCard title="Workflow" icon="terminal" variant="frosted">
            <Text size="sm" tone="muted">Vercel deploys from Git and gives every branch a preview URL. Reverhost deploys from a CLI that coding agents can drive end to end.</Text>
          </FeatureCard>
          <FeatureCard title="Reach" icon="globe" variant="frosted">
            <Text size="sm" tone="muted">Vercel serves from a global edge network. Reverhost serves from one region.</Text>
          </FeatureCard>
        </Grid>
      </Stack>
    </Box>

    <Box as="section" id="table" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">Reverhost and Vercel Hobby side by side</Heading>
        <Text tone="muted">Vercel details are from the <Link href="https://vercel.com/docs/plans/hobby" rel="noopener">Vercel Hobby plan docs</Link> as of September 2026. Those docs also state that the Hobby plan is restricted to non-commercial, personal use.</Text>
        <Table columns={["", "Reverhost", "Vercel Hobby"]} highlight={1}>
          <Row><Cell head>Price</Cell><Cell>$0, no credit card</Cell><Cell>$0</Cell></Row>
          <Row><Cell head>How the app runs</Cell><Cell>One always-on container, 256 MB RAM, 0.5 CPU</Cell><Cell>Serverless functions, up to 300 seconds each</Cell></Row>
          <Row><Cell head>Monthly usage</Cell><Cell>Not metered</Cell><Cell>100 GB data transfer, 1,000,000 function invocations, 4 CPU-hours</Cell></Row>
          <Row><Cell head>Over the limit</Cell><Cell>Fixed resources, nothing to exceed</Cell><Cell>The feature is paused until 30 days have passed</Cell></Row>
          <Row><Cell head>Projects</Cell><Cell>3</Cell><Cell>200</Cell></Row>
          <Row><Cell head>Postgres</Cell><Cell status="yes">Included, 1 per project</Cell><Cell status="partial">Through integrations</Cell></Row>
          <Row><Cell head>File storage</Cell><Cell status="yes">S3 compatible bucket, 1 per project</Cell><Cell status="yes">Vercel Blob</Cell></Row>
          <Row><Cell head>Git deploys and previews</Cell><Cell status="no">No</Cell><Cell status="yes">Yes</Cell></Row>
          <Row><Cell head>Global CDN</Cell><Cell status="no">No</Cell><Cell status="yes">Yes</Cell></Row>
          <Row><Cell head>Frameworks</Cell><Cell>Any language with a Dockerfile, including Next.js</Cell><Cell>Many</Cell></Row>
        </Table>
      </Stack>
    </Box>

    <Box as="section" id="easyhost-fits" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">When Reverhost is the better fit</Heading>
        <Grid cols={2} gap="sm">
          <FeatureCard title="You want a server, not functions" icon="server" iconTone="green">
            <Text size="sm" tone="muted">Your app is a single process that stays running. In-memory caches survive between requests, there are no cold starts, and you do not need to think about function size or invocation counts.</Text>
          </FeatureCard>
          <FeatureCard title="You want the backend in the same place" icon="database" iconTone="green">
            <Text size="sm" tone="muted">A side project usually needs a database and somewhere to put uploads. On Reverhost those are two commands in the same CLI: <InlineCode>ezhst db create</InlineCode> and <InlineCode>ezhst storage create</InlineCode>. See <Link href="/free-postgres-hosting">free Postgres hosting</Link> for the database details.</Text>
          </FeatureCard>
          <FeatureCard title="Your coding agent does the deploying" icon="bot" iconTone="green">
            <Text size="sm" tone="muted">Every <InlineCode>ezhst</InlineCode> command takes <InlineCode>--json</InlineCode>, never prompts without a terminal, and returns errors an agent can act on. Sign-up works from the command line too: after you give the agent the 6-digit code from your inbox, it can go from an empty account to a live URL without a browser. The <Link href="/guides/deploy-nextjs-with-ai-agents">agent deploy guide</Link> shows how.</Text>
          </FeatureCard>
          <FeatureCard title="You want limits you can predict" icon="gauge" iconTone="green">
            <Text size="sm" tone="muted">There is no usage meter. An app gets 256 MB of RAM and 0.5 CPU, and that is what it has at any traffic level.</Text>
          </FeatureCard>
        </Grid>
      </Stack>
    </Box>

    <Box as="section" id="vercel-fits" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">When Vercel is the better fit</Heading>
        <Text tone="muted">Reverhost is young and deliberately small. Choose Vercel if any of these matter to you:</Text>
        <Box tone="white" border shadow radius="lg" padding="md">
          <List marker="dot" gap="md" divided>
            <ListItem icon="globe" tone="orange">Visitors all over the world and you need pages served from an edge location near them.</ListItem>
            <ListItem icon="git-branch" tone="orange">Preview deployments for every pull request, or deploys triggered by a Git push.</ListItem>
            <ListItem icon="activity" tone="orange">Traffic beyond what one 256 MB container can serve.</ListItem>
            <ListItem icon="users" tone="orange">Team features, analytics, firewall rules and the rest of a mature platform.</ListItem>
            <ListItem icon="code" tone="orange">Applications that cannot run as a single container from a Dockerfile.</ListItem>
          </List>
        </Box>
      </Stack>
    </Box>

    <Box as="section" id="migrate" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">Moving a Next.js app from Vercel to Reverhost</Heading>
        <NumberedList layout="stack">
          <NumberedItem text="Pull your environment variables from Vercel into a local file, then import them." />
          <NumberedItem text="Create a project, link the folder, save a Dockerfile to the app and deploy. Change the template start command to next start -H 0.0.0.0 -p $PORT." />
          <NumberedItem text="Add your domain and point DNS at Reverhost." />
        </NumberedList>
        <CodeBlock code={migrateCode} />
        <Heading level={3} size="sm">Things to check first</Heading>
        <Box tone="white" border shadow radius="lg" padding="md">
          <List marker="dot" gap="md" divided>
            <ListItem icon="package" tone="muted"><Text as="strong" weight="semibold">Vercel-only packages.</Text> Replace <InlineCode>@vercel/blob</InlineCode> with any S3 client pointed at your Reverhost bucket, and point your Postgres client at the Reverhost connection string.</ListItem>
            <ListItem icon="clock" tone="muted"><Text as="strong" weight="semibold">Cron jobs in <InlineCode>vercel.json</InlineCode>.</Text> Reverhost does not read <InlineCode>vercel.json</InlineCode>, so scheduled routes will not be called.</ListItem>
            <ListItem icon="globe" tone="muted"><Text as="strong" weight="semibold">Edge runtime.</Text> Everything runs in the one container in a single region.</ListItem>
            <ListItem icon="monitor" tone="muted"><Text as="strong" weight="semibold">Image optimization.</Text> <InlineCode>next/image</InlineCode> is handled by the Next.js server inside your container.</ListItem>
          </List>
        </Box>
      </Stack>
    </Box>

    <Box as="section" id="faq" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">Frequently asked questions</Heading>
        <Accordion>
          <AccordionItem question="Is Reverhost a drop-in replacement for Vercel?">
            <Text tone="muted">For a standard Next.js app, mostly yes: it builds with <InlineCode>next build</InlineCode> and runs with <InlineCode>next start</InlineCode> without changes. Vercel-specific services such as Vercel Blob, <InlineCode>vercel.json</InlineCode> cron jobs, preview deployments and the edge network do not carry over.</Text>
          </AccordionItem>
          <AccordionItem question="Is Reverhost faster than Vercel?">
            <Text tone="muted">It depends on where your visitors are. Reverhost has no cold starts because the container is always on, but it serves from one region. Vercel serves static assets from a global CDN.</Text>
          </AccordionItem>
          <AccordionItem question="Can I keep my custom domain when I move?">
            <Text tone="muted">Yes. Add it with <InlineCode>ezhst domains add</InlineCode>, set the DNS record that <InlineCode>ezhst domains list</InlineCode> shows, then run <InlineCode>ezhst domains verify</InlineCode> to issue HTTPS. Details in the <Link href="/docs#domains">domains docs</Link>.</Text>
          </AccordionItem>
        </Accordion>
      </Stack>
    </Box>

    <StartCta />
  </DocLayout>

  <Footer cta={false} />
</Base>
