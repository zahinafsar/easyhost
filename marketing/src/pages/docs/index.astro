---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import NavLink from "../../components/ui/NavLink.astro";
import Section from "../../components/ui/Section.astro";
import Frame from "../../components/ui/Frame.astro";
import Stack from "../../components/ui/Stack.astro";
import Grid from "../../components/ui/Grid.astro";
import Box from "../../components/ui/Box.astro";
import Card from "../../components/ui/Card.astro";
import Heading from "../../components/ui/Heading.astro";
import Accent from "../../components/ui/Accent.astro";
import Text from "../../components/ui/Text.astro";
import Link from "../../components/ui/Link.astro";
import InlineCode from "../../components/ui/InlineCode.astro";
import Badge from "../../components/ui/Badge.astro";
import Button from "../../components/ui/Button.astro";
import IconTile from "../../components/ui/IconTile.astro";
import DocLayout from "../../components/ui/DocLayout.astro";
import Toc from "../../components/ui/Toc.astro";
import Table from "../../components/ui/Table.astro";
import Row from "../../components/ui/Row.astro";
import Cell from "../../components/ui/Cell.astro";
import CodeBlock from "../../components/ui/CodeBlock.astro";
import CopyLine from "../../components/ui/CopyLine.astro";
import CommandList from "../../components/ui/CommandList.astro";
import CommandRow from "../../components/ui/CommandRow.astro";
import Callout from "../../components/ui/Callout.astro";
import List from "../../components/ui/List.astro";
import ListItem from "../../components/ui/ListItem.astro";

const toc = [
  { href: "#quick-start", label: "Quick start" },
  { href: "#skill", label: "Agent skill" },
  { href: "#authentication", label: "Authentication" },
  { href: "#projects", label: "Projects and linking" },
  { href: "#deploying", label: "Deploying" },
  { href: "#env", label: "Environment variables" },
  { href: "#build", label: "Build settings" },
  { href: "#logs", label: "Logs" },
  { href: "#domains", label: "Custom domains" },
  { href: "#storage", label: "Storage" },
  { href: "#database", label: "Database" },
  { href: "#members", label: "Team members" },
  { href: "#ai-builder", label: "AI Builder" },
  { href: "#limits", label: "Limits" },
];

const humanDeployCode = `npx ezhst register
npx ezhst verify <code>
npx ezhst link
npx ezhst deploy`;

const projectsCode = `ezhst projects create my-project
ezhst projects list
ezhst apps create my-api --project <project-slug>
ezhst link --project <project-slug> --app <app-slug>`;

const envCode = `ezhst env set NEXT_PUBLIC_SITE_URL=https://my-app.easyhost.fun
ezhst env import .env.production
ezhst redeploy`;

const buildCode = `ezhst build dockerfile template
ezhst build dockerfile template node > Dockerfile
ezhst build dockerfile set -f Dockerfile
ezhst build set --root-dir apps/web
ezhst redeploy`;

const buildSecretCode = `RUN --mount=type=secret,id=appenv,target=/run/secrets/appenv sh -c 'set -a; . /run/secrets/appenv; set +a; npm run build'`;

const logsCode = `ezhst deployments log --json
ezhst logs --tail 200`;

const domainsCode = `ezhst domains add www.example.com
ezhst domains list
ezhst domains verify www.example.com`;

const storageCode = `import { S3Client, PutObjectCommand } from "@aws-sdk/client-s3";

export const s3 = new S3Client({
  endpoint: "https://storage.reverhost.com",
  region: "us-east-1",
  forcePathStyle: true,
  credentials: {
    accessKeyId: process.env.S3_ACCESS_KEY_ID!,
    secretAccessKey: process.env.S3_SECRET_ACCESS_KEY!,
  },
});

export const uploadAvatar = async (userId: string, body: Buffer) => {
  await s3.send(
    new PutObjectCommand({
      Bucket: process.env.S3_BUCKET!,
      Key: \`avatars/\${userId}.png\`,
      Body: body,
      ContentType: "image/png",
    }),
  );
};`;

const databaseCode = `ezhst db create main
ezhst db info --json
ezhst env set DATABASE_URL="postgresql://..."`;

const prismaCode = `datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}`;
---

<Base>
  <Fragment slot="head">
    <title>Reverhost Docs: ezhst CLI Reference for Deploying Apps</title>
    <meta name="description" content="Every ezhst command: deploy apps in any language from a Dockerfile, set environment variables, read logs, add custom domains, and use S3 storage and Postgres." />
    <link rel="canonical" href="https://reverhost.com/docs" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Reverhost" />
    <meta property="og:url" content="https://reverhost.com/docs" />
    <meta property="og:title" content="Reverhost Docs: ezhst CLI Reference for Deploying Apps" />
    <meta property="og:description" content="Every ezhst command: deploy apps from a Dockerfile, manage env vars, domains, S3 storage and Postgres." />
    <meta property="og:image" content="https://reverhost.com/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://reverhost.com/og.png" />
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "TechArticle",
            "headline": "Reverhost docs: ezhst CLI reference",
            "description": "Every ezhst command: deploy apps in any language from a Dockerfile, set environment variables, read logs, add custom domains, and use S3 storage and Postgres.",
            "url": "https://reverhost.com/docs",
            "image": "https://reverhost.com/og.png",
            "datePublished": "2026-09-29",
            "dateModified": "2026-11-25",
            "author": { "@type": "Organization", "name": "Reverhost", "url": "https://reverhost.com/" },
            "publisher": { "@type": "Organization", "name": "Reverhost", "url": "https://reverhost.com/", "logo": "https://reverhost.com/icon-512.png" }
          },
          {
            "@type": "BreadcrumbList",
            "itemListElement": [
              { "@type": "ListItem", "position": 1, "name": "Reverhost", "item": "https://reverhost.com/" },
              { "@type": "ListItem", "position": 2, "name": "Docs", "item": "https://reverhost.com/docs" }
            ]
          }
        ]
      }
    </script>
  </Fragment>

  <Nav docs>
    <NavLink href="/">Home</NavLink>
    <NavLink href="/docs" keep current>Docs</NavLink>
    <NavLink href="/skill.md">skill.md</NavLink>
  </Nav>

  <Section size="full" space="none">
    <Frame padding="md">
      <Stack gap="md" align="center">
        <Heading level={1} size="xl" align="center" maxWidth="820px" reveal={0}>Reverhost docs: the <Accent>ezhst CLI</Accent></Heading>
        <Text size="lg" tone="muted" align="center" maxWidth="680px" balance reveal={1}>Everything on Reverhost runs through the <InlineCode>ezhst</InlineCode> CLI, which is built to be driven by coding agents. This page covers every command.</Text>
        <Box maxWidth="460px" reveal={2}>
          <CopyLine command="npx ezhst skill install" />
        </Box>
        <Stack direction="row" gap="xs" wrap justify="center" reveal={2}>
          <Badge tone="white" icon="braces">--json on every command</Badge>
          <Badge tone="white" icon="terminal">No prompts without a TTY</Badge>
          <Badge tone="white" icon="lock">EZHST_TOKEN for CI</Badge>
        </Stack>
      </Stack>
    </Frame>
  </Section>

  <DocLayout>
    <Toc slot="aside" items={toc} />

    <Box as="section" id="quick-start" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">Quick start</Heading>
        <Grid cols={2} gap="sm" align="stretch">
          <Card variant="frosted" padding="md">
            <Stack gap="sm">
              <IconTile icon="bot" tone="green" size="sm" />
              <Heading level={3} size="sm">For agents</Heading>
              <Text size="sm" tone="muted">Run the installer and choose Global for all projects or Local for the current project, then ask your agent to deploy.</Text>
              <CodeBlock code="npx ezhst skill install" />
              <Text size="sm" tone="muted">Then tell it: <InlineCode>Deploy this to Reverhost</InlineCode>. The <Link href="/guides/deploy-nextjs-with-ai-agents">agent deploy guide</Link> walks through it for each agent. The agent creates an account if you do not have one, creates and links a project, sets environment variables and deploys.</Text>
            </Stack>
          </Card>
          <Card variant="frosted" padding="md">
            <Stack gap="sm">
              <IconTile icon="terminal" tone="dark" size="sm" />
              <Heading level={3} size="sm">For humans</Heading>
              <Text size="sm" tone="muted">Install the CLI globally or run it with <InlineCode>npx</InlineCode>.</Text>
              <CodeBlock code="npm i -g ezhst" />
              <Text size="sm" tone="muted">Create an account (or log in), link your app folder, set a Dockerfile and deploy.</Text>
              <CodeBlock code={humanDeployCode} />
              <Text size="sm" tone="muted">Already have an account? Use <InlineCode>npx ezhst login</InlineCode> instead of <InlineCode>register</InlineCode>. You can also sign up in the <Link href="https://app.reverhost.com/register">dashboard</Link>.</Text>
            </Stack>
          </Card>
        </Grid>
      </Stack>
    </Box>

    <Box as="section" id="skill" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">Installing the agent skill</Heading>
        <Text tone="muted">The skill is a single <InlineCode>SKILL.md</InlineCode> file that teaches your agent how to use Reverhost.</Text>
        <CommandList>
          <CommandRow command="ezhst skill install">Asks which agent (Claude Code, Codex or Cursor), then Global or Local.</CommandRow>
          <CommandRow command="ezhst skill install --agent claude --global">Writes <InlineCode>~/.claude/skills/easyhost/SKILL.md</InlineCode> for use across projects.</CommandRow>
          <CommandRow command="ezhst skill install --agent cursor --local">Writes <InlineCode>.cursor/skills/easyhost/SKILL.md</InlineCode> in the current project.</CommandRow>
        </CommandList>
        <Text tone="muted">Claude Code uses <InlineCode>.claude/skills</InlineCode>, Codex uses <InlineCode>.agents/skills</InlineCode> and Cursor uses <InlineCode>.cursor/skills</InlineCode>, under your home folder for Global or the current directory for Local. Choose Local to check the skill into the repo for your team. For noninteractive use, including <InlineCode>--json</InlineCode>, pass <InlineCode>--agent &lt;claude|codex|cursor&gt;</InlineCode> and exactly one of <InlineCode>--global</InlineCode> or <InlineCode>--local</InlineCode>.</Text>
        <Text tone="muted">For other agents, ask them to read the raw file at <Link href="/skill.md">https://reverhost.com/skill.md</Link> before deploying.</Text>
      </Stack>
    </Box>

    <Box as="section" id="authentication" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">Authentication</Heading>
        <CommandList>
          <CommandRow command={"ezhst register --name <name> --email <email> --password <password>"}>Create an account. A "Default project" is created and a 6-digit verification code is emailed to you.</CommandRow>
          <CommandRow command={"ezhst verify <code>"}>Verify your email with the code. Required before any other command.</CommandRow>
          <CommandRow command={"ezhst login --email <email> --password <password>"}>Log in.</CommandRow>
          <CommandRow command="ezhst logout">Log out.</CommandRow>
          <CommandRow command="ezhst whoami">Show the logged in account.</CommandRow>
          <CommandRow command="ezhst resend-verification">Email a new code. Codes expire after 10 minutes, and you can request one every 60 seconds.</CommandRow>
          <CommandRow command={"ezhst forgot-password --email <email>"}>Send a password reset link.</CommandRow>
        </CommandList>
        <Text tone="muted">Verification is mandatory. Until you run <InlineCode>ezhst verify</InlineCode> with the code from your inbox, other commands are rejected. In the dashboard, the same code is entered on the screen shown after sign up.</Text>
        <Text tone="muted"><InlineCode>login</InlineCode> and <InlineCode>register</InlineCode> save your token in <InlineCode>~/.easyhost/config.json</InlineCode>. In CI or agent sandboxes, provide the token with the <InlineCode>EZHST_TOKEN</InlineCode> environment variable instead.</Text>
        <CodeBlock code={"EZHST_TOKEN=<token> npx ezhst deploy --json"} />
        <Heading level={3} size="sm">Output and prompts</Heading>
        <List gap="sm">
          <ListItem icon="braces" tone="green">Every command accepts <InlineCode>--json</InlineCode> for machine readable output. Agents should always use it.</ListItem>
          <ListItem icon="terminal" tone="green">In a terminal, missing values are asked for interactively. Without a TTY the CLI never prompts: it fails with a message naming the missing flag.</ListItem>
        </List>
      </Stack>
    </Box>

    <Box as="section" id="projects" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">Projects and linking</Heading>
        <Text tone="muted">A project contains up to 2 apps (your own apps and AI Builder apps count together) with a shared storage bucket and database. Each app has its own subdomain: <InlineCode>&lt;app-slug&gt;.easyhost.fun</InlineCode>.</Text>
        <CommandList>
          <CommandRow command="ezhst projects list">List your projects.</CommandRow>
          <CommandRow command={"ezhst projects create <name>"}>Create a project.</CommandRow>
          <CommandRow command="ezhst projects info">Project details and apps.</CommandRow>
          <CommandRow command={"ezhst projects rename <name>"}>Change the display name. The URL stays the same.</CommandRow>
          <CommandRow command="ezhst projects delete --yes">Delete all apps, deployments, storage and the database.</CommandRow>
          <CommandRow command={"ezhst link [--project <slug>]"}>Link the current folder to a project (writes <InlineCode>.easyhost.json</InlineCode>).</CommandRow>
        </CommandList>
        <Text tone="muted">Project-scoped commands use the project linked in <InlineCode>.easyhost.json</InlineCode>. Pass <InlineCode>--project &lt;slug&gt;</InlineCode> to any of them to target another project.</Text>
        <CodeBlock code={projectsCode} />
      </Stack>
    </Box>

    <Box as="section" id="deploying" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">Deploying</Heading>
        <Text tone="muted">Use <InlineCode>ezhst apps list</InlineCode>, <InlineCode>ezhst apps create &lt;name&gt;</InlineCode>, and <InlineCode>ezhst apps delete --app &lt;slug&gt; --yes</InlineCode> to manage up to 2 apps per project. Deployment, environment, build, domain and runtime commands accept <InlineCode>--app &lt;slug-or-id&gt;</InlineCode>. Link an app with <InlineCode>ezhst link --project &lt;slug&gt; --app &lt;slug&gt;</InlineCode>.</Text>
        <CommandList>
          <CommandRow command="ezhst deploy [--verbose]">Package the current folder, upload it, build it with the app Dockerfile and go live. Fails fast if the app has no Dockerfile.</CommandRow>
          <CommandRow command="ezhst redeploy [--verbose]">Rebuild the latest upload, even a failed one. Use after fixing the Dockerfile or changing env vars.</CommandRow>
          <CommandRow command="ezhst start">Start the app.</CommandRow>
          <CommandRow command="ezhst stop">Stop the app.</CommandRow>
          <CommandRow command="ezhst deployments list">List deployments.</CommandRow>
        </CommandList>
        <Heading level={3} size="sm">What gets uploaded</Heading>
        <Text tone="muted"><InlineCode>deploy</InlineCode> uploads your project source. It skips <InlineCode>node_modules</InlineCode>, <InlineCode>.next</InlineCode>, <InlineCode>.git</InlineCode>, every <InlineCode>.env*</InlineCode> file, Python virtual environments, Rust <InlineCode>target</InlineCode> and Zig output. Reverhost then builds the Dockerfile stored on the app and runs the image.</Text>
        <Callout tone="warning">
          <Text size="sm">Environment variables are not read from your <InlineCode>.env</InlineCode> files. Set them with <InlineCode>ezhst env set</InlineCode> or <InlineCode>ezhst env import .env</InlineCode> before deploying.</Text>
        </Callout>
        <Text tone="muted">Your app is live at <InlineCode>https://&lt;slug&gt;.easyhost.fun</InlineCode> once the build finishes.</Text>
      </Stack>
    </Box>

    <Box as="section" id="env" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">Environment variables</Heading>
        <Text tone="muted">Variables are applied on the next <InlineCode>deploy</InlineCode> or <InlineCode>redeploy</InlineCode>.</Text>
        <CommandList>
          <CommandRow command="ezhst env list">List variables.</CommandRow>
          <CommandRow command="ezhst env set KEY=VALUE [KEY=VALUE...]">Set one or more variables.</CommandRow>
          <CommandRow command="ezhst env unset KEY [KEY...]">Remove one or more variables.</CommandRow>
          <CommandRow command={"ezhst env import <file>"}>Merge the variables from a .env file.</CommandRow>
        </CommandList>
        <CodeBlock code={envCode} />
      </Stack>
    </Box>

    <Box as="section" id="build" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">Build settings</Heading>
        <Text tone="muted">Every app is built from a Dockerfile stored on the app in Reverhost, so any language works: Node.js, Bun, Python, Go, Ruby, PHP, Rust, Zig or anything else you can write a Dockerfile for. A Dockerfile in your repository is not used automatically. Edit it in the dashboard Build tab or upload it with <InlineCode>ezhst build dockerfile set -f Dockerfile</InlineCode>.</Text>
        <CommandList>
          <CommandRow command="ezhst build show">Show the root directory and the stored Dockerfile.</CommandRow>
          <CommandRow command={"ezhst build set --root-dir <dir>"}>Set the build context folder, for example an app folder in a monorepo.</CommandRow>
          <CommandRow command="ezhst build reset">Clear the root directory and the Dockerfile. Set a Dockerfile again before the next deploy.</CommandRow>
          <CommandRow command="ezhst build dockerfile show">Print the stored Dockerfile.</CommandRow>
          <CommandRow command={"ezhst build dockerfile set -f <file>"}>Upload a Dockerfile. Use <InlineCode>-f -</InlineCode> to read it from stdin.</CommandRow>
          <CommandRow command={"ezhst build dockerfile template [id] [--apply]"}>List starter templates, print one, or save it to the app with <InlineCode>--apply</InlineCode>.</CommandRow>
        </CommandList>
        <Text tone="muted">Template ids: <InlineCode>node</InlineCode>, <InlineCode>bun</InlineCode>, <InlineCode>python</InlineCode>, <InlineCode>go</InlineCode>, <InlineCode>ruby</InlineCode>, <InlineCode>php</InlineCode>, <InlineCode>rust</InlineCode> and <InlineCode>zig</InlineCode>. Start from one, then adjust the build and start lines for your framework.</Text>
        <Heading level={3} size="sm">Rules for the Dockerfile</Heading>
        <Table columns={["Rule", "Details"]}>
          <Row><Cell head>Port</Cell><Cell>Listen on <InlineCode>0.0.0.0</InlineCode> and <InlineCode>$PORT</InlineCode>, which is 3000</Cell></Row>
          <Row><Cell head>Environment</Cell><Cell>Your variables are runtime env in the container</Cell></Row>
          <Row><Cell head>Build-time variables</Cell><Cell>Mount the <InlineCode>appenv</InlineCode> secret in the <InlineCode>RUN</InlineCode> step that needs them. Never pass secrets with <InlineCode>ARG</InlineCode> or <InlineCode>ENV</InlineCode></Cell></Row>
          <Row><Cell head>Image size</Cell><Cell>Up to 1 GB, so prefer slim base images and multi-stage builds</Cell></Row>
        </Table>
        <CodeBlock code={buildSecretCode} />
        <CodeBlock code={buildCode} />
      </Stack>
    </Box>

    <Box as="section" id="logs" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">Logs and build logs</Heading>
        <CommandList>
          <CommandRow command={"ezhst logs [--tail <lines>]"}>Runtime logs from the running app.</CommandRow>
          <CommandRow command="ezhst deployments log [deploymentId]">Full build log. Defaults to the latest deployment.</CommandRow>
        </CommandList>
        <Text tone="muted">When a deploy fails, read the build log, fix the cause and run <InlineCode>ezhst deploy</InlineCode> again.</Text>
        <CodeBlock code={logsCode} />
      </Stack>
    </Box>

    <Box as="section" id="domains" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">Custom domains</Heading>
        <CommandList>
          <CommandRow command="ezhst domains list">List domains with the DNS target for each.</CommandRow>
          <CommandRow command={"ezhst domains add <hostname>"}>Add a domain.</CommandRow>
          <CommandRow command={"ezhst domains verify <hostname>"}>Check DNS, then issue HTTPS.</CommandRow>
          <CommandRow command={"ezhst domains remove <hostname>"}>Remove a domain.</CommandRow>
        </CommandList>
        <Heading level={3} size="sm">DNS records</Heading>
        <Table columns={["Domain", "Type", "Value"]}>
          <Row><Cell>Subdomain, like <InlineCode>www.example.com</InlineCode></Cell><Cell mono>CNAME</Cell><Cell><InlineCode>&lt;slug&gt;.easyhost.fun</InlineCode></Cell></Row>
          <Row><Cell>Root domain, like <InlineCode>example.com</InlineCode></Cell><Cell mono>A</Cell><Cell>Server IP shown by <InlineCode>ezhst domains list</InlineCode></Cell></Row>
        </Table>
        <CodeBlock code={domainsCode} />
      </Stack>
    </Box>

    <Box as="section" id="storage" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">Storage <Badge tone="green">S3 compatible</Badge></Heading>
        <Text tone="muted">Each project gets one bucket. Files are public by URL.</Text>
        <CommandList>
          <CommandRow command="ezhst storage info">Bucket, public base URL and S3 credentials.</CommandRow>
          <CommandRow command={"ezhst storage create <name>"}>Create the bucket.</CommandRow>
          <CommandRow command="ezhst storage rotate-keys">Issue new S3 credentials.</CommandRow>
          <CommandRow command="ezhst storage ls [prefix]">List files.</CommandRow>
          <CommandRow command={"ezhst storage upload <files...> [--prefix <path/>]"}>Upload files.</CommandRow>
          <CommandRow command={"ezhst storage download <key> [output]"}>Download a file.</CommandRow>
          <CommandRow command={"ezhst storage rm <key>"}>Delete a file.</CommandRow>
          <CommandRow command="ezhst storage delete --yes">Delete the bucket.</CommandRow>
        </CommandList>
        <Heading level={3} size="sm">Using it from your app</Heading>
        <Text tone="muted">Run <InlineCode>ezhst storage info</InlineCode>, store the credentials with <InlineCode>ezhst env set</InlineCode>, then use any S3 client. The endpoint is <InlineCode>https://storage.reverhost.com</InlineCode>, the region is <InlineCode>us-east-1</InlineCode> and requests must use path-style URLs.</Text>
        <CodeBlock code={storageCode} label="lib/storage.ts" />
        <Text tone="muted">The file is then served at the public base URL from <InlineCode>storage info</InlineCode> followed by its key.</Text>
      </Stack>
    </Box>

    <Box as="section" id="database" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">Database <Badge tone="green">Postgres</Badge></Heading>
        <Text tone="muted">Each project gets one managed Postgres database. See <Link href="/free-postgres-hosting">free Postgres hosting</Link> for what is included.</Text>
        <CommandList>
          <CommandRow command="ezhst db info">Connection string, shadow connection string and tables.</CommandRow>
          <CommandRow command={"ezhst db create <name>"}>Create the database.</CommandRow>
          <CommandRow command={'ezhst db query "<sql>"'}>Run a SQL statement.</CommandRow>
          <CommandRow command={"ezhst db query --file <file.sql>"}>Run a SQL file.</CommandRow>
          <CommandRow command={"ezhst db rows <table> [--page <n>]"}>Browse rows in a table.</CommandRow>
          <CommandRow command="ezhst db reset-password">Rotate the password and print the new connection string.</CommandRow>
          <CommandRow command="ezhst db delete --yes">Delete the database.</CommandRow>
        </CommandList>
        <Heading level={3} size="sm">Connecting your app</Heading>
        <Text tone="muted">Copy the connection string from <InlineCode>ezhst db info</InlineCode> into your app's environment. It works with Prisma, Drizzle or any Postgres client.</Text>
        <CodeBlock code={databaseCode} />
        <Heading level={3} size="sm">Prisma migrations</Heading>
        <Text tone="muted"><InlineCode>prisma migrate dev</InlineCode> needs a shadow database. Use the shadow connection string from <InlineCode>ezhst db info</InlineCode>.</Text>
        <CodeBlock code={prismaCode} label="prisma/schema.prisma" />
        <Text tone="muted">After <InlineCode>ezhst db reset-password</InlineCode>, update <InlineCode>DATABASE_URL</InlineCode> with <InlineCode>ezhst env set</InlineCode> and run <InlineCode>ezhst redeploy</InlineCode>.</Text>
      </Stack>
    </Box>

    <Box as="section" id="members" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">Team members</Heading>
        <Text tone="muted">Invite people to a project by email. Members can manage everything in it. Only the owner can invite, revoke invites, remove members, rename or delete the project.</Text>
        <CommandList>
          <CommandRow command="ezhst members list">Show the owner, members and pending invites.</CommandRow>
          <CommandRow command={"ezhst members invite <email>"}>Email an invite. The link is valid for 7 days and is also printed.</CommandRow>
          <CommandRow command={"ezhst members revoke <email>"}>Revoke a pending invite.</CommandRow>
          <CommandRow command={"ezhst members remove <email> --yes"}>Remove a member.</CommandRow>
          <CommandRow command="ezhst members leave --yes">Leave a project you were invited to.</CommandRow>
          <CommandRow command={"ezhst accept-invite <link-or-token>"}>Join a project. Log in with the invited email first.</CommandRow>
        </CommandList>
      </Stack>
    </Box>

    <Box as="section" id="ai-builder" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">AI Builder <Badge tone="neutral">dashboard</Badge></Heading>
        <Text tone="muted">The AI Builder turns a description into a running app. Open <Text as="strong" weight="semibold" tone="default">Builder</Text> in the <Link href="https://app.reverhost.com/builder">dashboard</Link>, create an app and describe it. The name becomes its address, <InlineCode>https://&lt;name&gt;.easyhost.fun</InlineCode>.</Text>
        <Text tone="muted">For a new app or a big feature, the AI asks a few questions, shows a short plan to approve and lets you pick one of 9 themes before it builds. Small changes go straight to code. Every step is shown live: files written, SQL run and packages installed.</Text>
        <Text tone="muted">To point at part of the page, click <Text as="strong" weight="semibold" tone="default">Select element</Text> and then the element in the preview. It is tagged in your message so the AI knows exactly what to change. You can also attach up to 5 images per message (png, jpg, gif, webp, avif, svg or ico, up to 5 MB each). They are saved in the app and served at <InlineCode>/uploads/&lt;name&gt;</InlineCode>, and the AI uses them only as they are, for example as a logo or background. It cannot see, edit, describe or generate images.</Text>
        <Text tone="muted">The menu next to <Text as="strong" weight="semibold" tone="default">Select element</Text> opens the <Text as="strong" weight="semibold" tone="default">Code</Text> view, where you can edit any file and save it straight into the running app, and <Text as="strong" weight="semibold" tone="default">Export</Text>, which downloads all of the app's code as a zip.</Text>
        <Text tone="muted">AI apps are plain JavaScript Hono servers. They use the project's Postgres database and storage when they need them, and work with environment variables, logs and custom domains like any other app. The AI Builder is not part of the CLI.</Text>
        <Callout tone="info" icon="sparkles">
          <Text size="sm">Each account gets its first AI app and its first build free. After that, AI requests use AI tokens, and Pro ($10 a month) tops your balance up to 1,000 tokens every month. Each request is charged by how much work it takes, and a typical full build is a few hundred tokens. AI apps count toward the 2 apps per project.</Text>
        </Callout>
      </Stack>
    </Box>

    <Box as="section" id="limits" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">Limits</Heading>
        <Text tone="muted">Reverhost hosting is free within these limits. Pro costs $10 a month for 10 projects and 1,000 AI tokens a month; see <Link href="/pricing">pricing</Link>. Run <InlineCode>ezhst billing</InlineCode> to see your plan and usage, and <InlineCode>ezhst billing upgrade</InlineCode> for a Pro checkout link. Apps in any language are supported, including Next.js and HTTP APIs. The <Link href="/free-nextjs-hosting">free Next.js hosting</Link> page explains what each limit means in practice.</Text>
        <Table columns={["Resource", "Limit"]}>
          <Row><Cell head>Projects</Cell><Cell>3 (10 on Pro)</Cell></Row>
          <Row><Cell head>Apps</Cell><Cell>2 per project</Cell></Row>
          <Row><Cell head>Storage</Cell><Cell>1 bucket per project, 256 MB</Cell></Row>
          <Row><Cell head>Database</Cell><Cell>1 Postgres database per project, 128 MB</Cell></Row>
          <Row><Cell head>Team members</Cell><Cell>10 per project, including pending invites</Cell></Row>
          <Row><Cell head>AI Builder prompts</Cell><Cell>30 per day, per project</Cell></Row>
          <Row><Cell head>Builds per day</Cell><Cell>10 (50 on Pro), per account owner</Cell></Row>
          <Row><Cell head>Concurrent builds</Cell><Cell>1 per app</Cell></Row>
          <Row><Cell head>App container</Cell><Cell>256 MB RAM, 0.5 CPU</Cell></Row>
          <Row><Cell head>Image size</Cell><Cell>1 GB</Cell></Row>
        </Table>
        <Stack direction="row" gap="sm" wrap>
          <Button href="https://app.reverhost.com/register">Sign up free</Button>
          <Button href="/pricing" variant="secondary">See pricing</Button>
        </Stack>
      </Stack>
    </Box>
