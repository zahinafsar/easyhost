---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import StartCta from "../components/ui/StartCta.astro";
import NavLink from "../components/ui/NavLink.astro";
import Section from "../components/ui/Section.astro";
import Frame from "../components/ui/Frame.astro";
import Stack from "../components/ui/Stack.astro";
import Grid from "../components/ui/Grid.astro";
import Box from "../components/ui/Box.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
import Heading from "../components/ui/Heading.astro";
import Accent from "../components/ui/Accent.astro";
import Text from "../components/ui/Text.astro";
import Link from "../components/ui/Link.astro";
import InlineCode from "../components/ui/InlineCode.astro";
import Badge from "../components/ui/Badge.astro";
import Button from "../components/ui/Button.astro";
import DocLayout from "../components/ui/DocLayout.astro";
import Toc from "../components/ui/Toc.astro";
import Table from "../components/ui/Table.astro";
import Row from "../components/ui/Row.astro";
import Cell from "../components/ui/Cell.astro";
import FeatureCard from "../components/ui/FeatureCard.astro";
import CodeBlock from "../components/ui/CodeBlock.astro";
import List from "../components/ui/List.astro";
import ListItem from "../components/ui/ListItem.astro";
import Accordion from "../components/ui/Accordion.astro";
import AccordionItem from "../components/ui/AccordionItem.astro";

const crumbs = [
  { name: "Reverhost", path: "/" },
  { name: "Free Next.js hosting", path: "/free-nextjs-hosting" },
];

const toc = [
  { href: "#included", label: "What you get" },
  { href: "#how-it-runs", label: "How your app runs" },
  { href: "#deploy", label: "Deploy in a few commands" },
  { href: "#compare", label: "Compared to other free tiers" },
  { href: "#tradeoffs", label: "What it does not do" },
  { href: "#faq", label: "FAQ" },
];

const deployCode = `npx ezhst register
npx ezhst verify <code>
npx ezhst link
npx ezhst deploy`;
---

<Base>
  <Fragment slot="head">
    <title>Free Next.js Hosting with Postgres and Storage | Reverhost</title>
    <meta name="description" content="Host a Next.js app for $0 on an always-on container, with Postgres, S3 storage and custom domains included. No credit card. Here are the exact limits." />
    <link rel="canonical" href="https://reverhost.com/free-nextjs-hosting" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Reverhost" />
    <meta property="og:url" content="https://reverhost.com/free-nextjs-hosting" />
    <meta property="og:title" content="Free Next.js Hosting with Postgres and Storage | Reverhost" />
    <meta property="og:description" content="Host a Next.js app for $0 on an always-on container, with Postgres, S3 storage and custom domains included." />
    <meta property="og:image" content="https://reverhost.com/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://reverhost.com/og.png" />
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "TechArticle",
            "headline": "Free Next.js hosting, with the backend included",
            "description": "Host a Next.js app for $0 on an always-on container, with Postgres, S3 storage and custom domains included. No credit card. Here are the exact limits.",
            "url": "https://reverhost.com/free-nextjs-hosting",
            "image": "https://reverhost.com/og.png",
            "datePublished": "2026-09-30",
            "dateModified": "2026-11-09",
            "author": {
              "@type": "Organization",
              "name": "Reverhost",
              "url": "https://reverhost.com/"
            },
            "publisher": {
              "@type": "Organization",
              "name": "Reverhost",
              "url": "https://reverhost.com/",
              "logo": "https://reverhost.com/icon-512.png"
            },
            "mainEntityOfPage": "https://reverhost.com/free-nextjs-hosting"
          },
          {
            "@type": "BreadcrumbList",
            "itemListElement": [
              {
                "@type": "ListItem",
                "position": 1,
                "name": "Reverhost",
                "item": "https://reverhost.com/"
              },
              {
                "@type": "ListItem",
                "position": 2,
                "name": "Free Next.js hosting",
                "item": "https://reverhost.com/free-nextjs-hosting"
              }
            ]
          },
          {
            "@type": "FAQPage",
            "mainEntity": [
              {
                "@type": "Question",
                "name": "Is there a catch to the free plan?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "No trial and no card. The catch is the limits: 3 projects, 512 MB of RAM and 1 CPU per app, one region, and two apps per project."
                }
              },
              {
                "@type": "Question",
                "name": "Does a free Next.js app on Reverhost sleep when nobody visits?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "No. The container keeps running, so there is no cold start after a period without traffic."
                }
              },
              {
                "@type": "Question",
                "name": "Can I host a full-stack Next.js app with a database for free?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Yes. Each project can have one Postgres database and one S3 compatible bucket alongside the app, all free."
                }
              },
              {
                "@type": "Question",
                "name": "Do I need to change my Next.js project to deploy it?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "No. There is no adapter, config file or output mode to set. The project needs a package.json with next and a build script."
                }
              }
            ]
          }
        ]
      }
    </script>
  </Fragment>

  <Nav>
    <NavLink href="/">Home</NavLink>
    <NavLink href="/free-nextjs-hosting">Free hosting</NavLink>
    <NavLink href="/vercel-alternative">vs Vercel</NavLink>
    <NavLink href="/docs" keep>Docs</NavLink>
  </Nav>

  <Section size="full" space="none">
    <Frame padding="md">
      <Stack gap="md" align="center">
        <Breadcrumbs items={crumbs} />
        <Heading level={1} size="xl" align="center" maxWidth="820px" reveal={0}>Free Next.js hosting, with the backend <Accent>included</Accent></Heading>
        <Text size="lg" tone="muted" align="center" maxWidth="720px" balance reveal={1}>Reverhost hosts Next.js apps for $0 a month. Each app runs in an always-on Node.js container with 512 MB of RAM and 1 CPU, gets HTTPS on its own subdomain, and can use a Postgres database and an S3 bucket from the same free account. Signing up does not need a credit card.</Text>
        <Stack direction="row" gap="xs" wrap justify="center" reveal={2}>
          <Badge tone="white" icon="cpu">512 MB RAM, 1 CPU</Badge>
          <Badge tone="white" icon="zap">Always on</Badge>
          <Badge tone="white" icon="database">Postgres included</Badge>
          <Badge tone="green" icon="credit-card">No credit card</Badge>
        </Stack>
        <Stack direction="row" gap="sm" wrap justify="center" reveal={2}>
          <Button href="https://app.reverhost.com/register" size="lg">Sign up free</Button>
          <Button href="/docs" variant="secondary" size="lg">Read the docs</Button>
        </Stack>
        <Text size="sm" tone="subtle" align="center">Last updated November 9, 2026</Text>
      </Stack>
    </Frame>
  </Section>

  <DocLayout>
    <Toc slot="aside" items={toc} />

    <Box as="section" id="included" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">What the free plan includes</Heading>
        <Text tone="muted">There is one plan and it is free. These are fixed limits, not a trial and not a monthly credit that runs out.</Text>
        <Table columns={["Resource", "Included"]}>
          <Row><Cell head>Projects</Cell><Cell>3 per account, 2 apps each (10 projects on Pro)</Cell></Row>
          <Row><Cell head>App container</Cell><Cell>512 MB RAM, 1 CPU, always on</Cell></Row>
          <Row><Cell head>URL and HTTPS</Cell><Cell><InlineCode>https://&lt;name&gt;.easyhost.fun</InlineCode> plus custom domains with automatic certificates</Cell></Row>
          <Row><Cell head>Postgres</Cell><Cell>1 database per project (Postgres 16), with a shadow database for Prisma</Cell></Row>
          <Row><Cell head>Object storage</Cell><Cell>1 S3 compatible bucket per project, files public by URL</Cell></Row>
          <Row><Cell head>Builds</Cell><Cell>1 at a time per account, queued in order</Cell></Row>
          <Row tone="highlight"><Cell head>Price</Cell><Cell status="yes">$0 per month, no credit card</Cell></Row>
        </Table>
        <Text tone="muted">The same numbers are listed in the <Link href="/docs#limits">docs</Link>.</Text>
      </Stack>
    </Box>

    <Box as="section" id="how-it-runs" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">How your Next.js app runs</Heading>
        <Text tone="muted">Reverhost builds your project into a container image and runs it as a normal Node.js server with <InlineCode>next start</InlineCode>. Nothing is rewritten into serverless functions, so the app behaves the way it does on your machine.</Text>
        <Grid cols={2} gap="sm">
          <FeatureCard title="Full Next.js server" icon="server" variant="frosted">
            <Text size="sm" tone="muted">Server rendering, route handlers, server actions, middleware and <InlineCode>next/image</InlineCode> all run inside your container.</Text>
          </FeatureCard>
          <FeatureCard title="Always on" icon="zap" iconTone="green" variant="frosted">
            <Text size="sm" tone="muted">The container is not stopped when traffic is idle, so the first request after a quiet night is as fast as any other.</Text>
          </FeatureCard>
          <FeatureCard title="Node 20, 22 or 24" icon="cpu" variant="frosted">
            <Text size="sm" tone="muted">Read from <InlineCode>engines.node</InlineCode> in <InlineCode>package.json</InlineCode>, otherwise Node 24.</Text>
          </FeatureCard>
          <FeatureCard title="npm, pnpm, yarn or bun" icon="package" variant="frosted">
            <Text size="sm" tone="muted">Detected from your lockfile.</Text>
          </FeatureCard>
          <FeatureCard title="Monorepos" icon="folder" variant="frosted">
            <Text size="sm" tone="muted">Point the build at a subfolder with <InlineCode>ezhst build set --root-dir apps/web</InlineCode>.</Text>
          </FeatureCard>
          <FeatureCard title="Environment variables" icon="lock" variant="frosted">
            <Text size="sm" tone="muted">Set with the CLI and passed to both the build and the running app, so <InlineCode>NEXT_PUBLIC_</InlineCode> values work.</Text>
          </FeatureCard>
        </Grid>
        <Text tone="muted">Build settings are auto-detected and can be overridden. See <Link href="/docs#build">build settings</Link>.</Text>
      </Stack>
    </Box>

    <Box as="section" id="deploy" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">Deploy in a few commands</Heading>
        <Text tone="muted">Run these inside your Next.js project folder, using the 6-digit code emailed to you after <InlineCode>register</InlineCode>. The CLI uploads your source, Reverhost installs, builds and starts it.</Text>
        <CodeBlock code={deployCode} />
        <Text tone="muted">Or let a coding agent do it. Run <InlineCode>npx ezhst skill install</InlineCode>, choose Global or Local, and tell Claude Code, Cursor or Codex to "deploy this to Reverhost". The <Link href="/guides/deploy-nextjs-with-ai-agents">agent deploy guide</Link> shows how to load the instructions and deploy.</Text>
        <Text tone="muted">Your <InlineCode>.env</InlineCode> files are never uploaded. Import them once with <InlineCode>ezhst env import .env</InlineCode>.</Text>
      </Stack>
    </Box>

    <Box as="section" id="compare" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">How it compares to other free Next.js hosting</Heading>
        <Text tone="muted">Free tiers differ more in shape than in size. This table uses each provider's own documentation as of September 2026: the <Link href="https://vercel.com/docs/plans/hobby" rel="noopener">Vercel Hobby plan docs</Link> and the <Link href="https://render.com/docs/free" rel="noopener">Render free tier docs</Link>.</Text>
        <Table columns={["", "Reverhost", "Vercel Hobby", "Render Free"]} highlight={1}>
          <Row><Cell head>How Next.js runs</Cell><Cell>Always-on container</Cell><Cell>Serverless functions and a global CDN</Cell><Cell>Container that spins down after 15 minutes without traffic and takes about a minute to spin back up</Cell></Row>
          <Row><Cell head>Usage limits</Cell><Cell>512 MB RAM and 1 CPU per app, 3 projects</Cell><Cell>100 GB data transfer, 1,000,000 function invocations and 4 CPU-hours per month</Cell><Cell>750 instance hours per month</Cell></Row>
          <Row><Cell head>Postgres</Cell><Cell status="yes">Included, 1 per project</Cell><Cell status="no">Not part of the plan (added through integrations)</Cell><Cell status="partial">Free database expires 30 days after creation, 1 GB</Cell></Row>
          <Row><Cell head>Deploy from Git</Cell><Cell status="no">No, CLI upload</Cell><Cell status="yes">Yes, with preview deployments</Cell><Cell status="yes">Yes</Cell></Row>
          <Row><Cell head>Regions</Cell><Cell>One</Cell><Cell>Global edge network</Cell><Cell>One per service</Cell></Row>
        </Table>
        <Text tone="muted">The short version: Vercel gives you the most polished Next.js platform and a worldwide CDN. Render gives you a general container host. Reverhost gives you one always-on Next.js container with a database and storage already attached. There is a longer write-up on the <Link href="/vercel-alternative">Vercel alternative</Link> page.</Text>
      </Stack>
    </Box>

    <Box as="section" id="tradeoffs" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">What Reverhost does not do</Heading>
        <Text tone="muted">Free hosting always has trade-offs. These are ours, stated plainly so you can decide before you deploy.</Text>
        <Box tone="white" border shadow radius="lg" padding="md">
          <List marker="dot" gap="md" divided>
            <ListItem icon="check" tone="green">Node.js apps are supported, including Next.js and APIs.</ListItem>
            <ListItem icon="globe" tone="orange">Apps run in one region. There is no edge network or CDN in front of them.</ListItem>
            <ListItem icon="git-branch" tone="orange">There is no Git integration and there are no preview deployments. You deploy with the CLI.</ListItem>
            <ListItem icon="cpu" tone="orange">512 MB of RAM is enough for most Next.js apps, but not for heavy in-process workloads.</ListItem>
            <ListItem icon="link" tone="orange">Files in a storage bucket are public to anyone who has the URL.</ListItem>
          </List>
        </Box>
      </Stack>
    </Box>

    <Box as="section" id="faq" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">Frequently asked questions</Heading>
        <Accordion>
          <AccordionItem question="Is there a catch to the free plan?">
            <Text tone="muted">No trial and no card. The catch is the limits: 3 projects, 512 MB of RAM and 1 CPU per app, one region, and two apps per project.</Text>
          </AccordionItem>
          <AccordionItem question="Does a free Next.js app on Reverhost sleep when nobody visits?">
            <Text tone="muted">No. The container keeps running, so there is no cold start after a period without traffic.</Text>
          </AccordionItem>
          <AccordionItem question="Can I host a full-stack Next.js app with a database for free?">
            <Text tone="muted">Yes. Each project can have one <Link href="/free-postgres-hosting">Postgres database</Link> and one S3 compatible bucket alongside the app, all free.</Text>
          </AccordionItem>
          <AccordionItem question="Do I need to change my Next.js project to deploy it?">
            <Text tone="muted">No. There is no adapter, config file or output mode to set. The project needs a <InlineCode>package.json</InlineCode> with <InlineCode>next</InlineCode> and a <InlineCode>build</InlineCode> script.</Text>
          </AccordionItem>
        </Accordion>
      </Stack>
    </Box>

    <StartCta />
  </DocLayout>

  <Footer cta={false} />
</Base>
