---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import CopyCode from "../components/CopyCode.astro";
---

<Base>
  <Fragment slot="head">
    <title>Free Next.js Hosting with Postgres and Storage | EasyHost</title>
    <meta name="description" content="Host a Next.js app for $0 on an always-on container, with Postgres, S3 storage and custom domains included. No credit card. Here are the exact limits." />
    <link rel="canonical" href="https://easyhost.fun/free-nextjs-hosting" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="EasyHost" />
    <meta property="og:url" content="https://easyhost.fun/free-nextjs-hosting" />
    <meta property="og:title" content="Free Next.js Hosting with Postgres and Storage | EasyHost" />
    <meta property="og:description" content="Host a Next.js app for $0 on an always-on container, with Postgres, S3 storage and custom domains included." />
    <meta property="og:image" content="https://easyhost.fun/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://easyhost.fun/og.png" />
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "TechArticle",
            "headline": "Free Next.js hosting, with the backend included",
            "description": "Host a Next.js app for $0 on an always-on container, with Postgres, S3 storage and custom domains included. No credit card. Here are the exact limits.",
            "url": "https://easyhost.fun/free-nextjs-hosting",
            "image": "https://easyhost.fun/og.png",
            "datePublished": "2026-09-30",
            "dateModified": "2026-11-09",
            "author": {
              "@type": "Organization",
              "name": "EasyHost",
              "url": "https://easyhost.fun/"
            },
            "publisher": {
              "@type": "Organization",
              "name": "EasyHost",
              "url": "https://easyhost.fun/",
              "logo": "https://easyhost.fun/icon-512.png"
            },
            "mainEntityOfPage": "https://easyhost.fun/free-nextjs-hosting"
          },
          {
            "@type": "BreadcrumbList",
            "itemListElement": [
              {
                "@type": "ListItem",
                "position": 1,
                "name": "EasyHost",
                "item": "https://easyhost.fun/"
              },
              {
                "@type": "ListItem",
                "position": 2,
                "name": "Free Next.js hosting",
                "item": "https://easyhost.fun/free-nextjs-hosting"
              }
            ]
          },
          {
            "@type": "FAQPage",
            "mainEntity": [
              {
                "@type": "Question",
                "name": "Is there a catch to the free plan?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "No trial and no card. The catch is the limits: 3 projects, 512 MB of RAM and 1 CPU per app, one region, and two apps per project."
                }
              },
              {
                "@type": "Question",
                "name": "Does a free Next.js app on EasyHost sleep when nobody visits?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "No. The container keeps running, so there is no cold start after a period without traffic."
                }
              },
              {
                "@type": "Question",
                "name": "Can I host a full-stack Next.js app with a database for free?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Yes. Each project can have one Postgres database and one S3 compatible bucket alongside the app, all free."
                }
              },
              {
                "@type": "Question",
                "name": "Do I need to change my Next.js project to deploy it?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "No. There is no adapter, config file or output mode to set. The project needs a package.json with next and a build script."
                }
              }
            ]
          }
        ]
      }
    </script>
  </Fragment>
    <Nav>
          <a href="/">Home</a>
          <a href="/free-nextjs-hosting">Free hosting</a>
          <a href="/vercel-alternative">vs Vercel</a>
          <a href="/docs" class="keep">Docs</a>
    </Nav>

    <div class="container docs">
      <aside class="toc">
        <p class="toc-title">On this page</p>
        <ol>
          <li><a href="#included">What you get</a></li>
          <li><a href="#how-it-runs">How your app runs</a></li>
          <li><a href="#deploy">Deploy in a few commands</a></li>
          <li><a href="#compare">Compared to other free tiers</a></li>
          <li><a href="#tradeoffs">What it does not do</a></li>
          <li><a href="#faq">FAQ</a></li>
        </ol>
      </aside>

      <main class="doc">
        <div class="doc-head">
          <ol class="crumbs" aria-label="Breadcrumb">
            <li><a href="/">EasyHost</a></li><li aria-current="page">Free Next.js hosting</li>
          </ol>
          <h1>Free Next.js hosting, with the backend included</h1>
          <p class="lead">EasyHost hosts Next.js apps for $0 a month. Each app runs in an always-on Node.js container with 512 MB of RAM and 1 CPU, gets HTTPS on its own subdomain, and can use a Postgres database and an S3 bucket from the same free account. Signing up does not need a credit card.</p>
          <p class="doc-meta">Last updated November 9, 2026</p>
        </div>

        <section id="included">
          <h2>What the free plan includes</h2>
          <p>There is one plan and it is free. These are fixed limits, not a trial and not a monthly credit that runs out.</p>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Resource</th><th>Included</th></tr></thead>
              <tbody>
                <tr><td>Projects</td><td>3 per account, 2 apps each (10 projects on Pro)</td></tr>
                <tr><td>App container</td><td>512 MB RAM, 1 CPU, always on</td></tr>
                <tr><td>URL and HTTPS</td><td><code>https://&lt;name&gt;.easyhost.fun</code> plus custom domains with automatic certificates</td></tr>
                <tr><td>Postgres</td><td>1 database per project (Postgres 16), with a shadow database for Prisma</td></tr>
                <tr><td>Object storage</td><td>1 S3 compatible bucket per project, files public by URL</td></tr>
                <tr><td>Builds</td><td>1 at a time per account, queued in order</td></tr>
                <tr><td>Price</td><td>$0 per month, no credit card</td></tr>
              </tbody>
            </table>
          </div>
          <p>The same numbers are listed in the <a href="/docs#limits">docs</a>.</p>
        </section>

        <section id="how-it-runs">
          <h2>How your Next.js app runs</h2>
          <p>EasyHost builds your project into a container image and runs it as a normal Node.js server with <code>next start</code>. Nothing is rewritten into serverless functions, so the app behaves the way it does on your machine.</p>
          <ul>
            <li><strong>Full Next.js server.</strong> Server rendering, route handlers, server actions, middleware and <code>next/image</code> all run inside your container.</li>
            <li><strong>Always on.</strong> The container is not stopped when traffic is idle, so the first request after a quiet night is as fast as any other.</li>
            <li><strong>Node 20, 22 or 24.</strong> Read from <code>engines.node</code> in <code>package.json</code>, otherwise Node 24.</li>
            <li><strong>npm, pnpm, yarn or bun.</strong> Detected from your lockfile.</li>
            <li><strong>Monorepos.</strong> Point the build at a subfolder with <code>ezhst build set --root-dir apps/web</code>.</li>
            <li><strong>Environment variables.</strong> Set with the CLI and passed to both the build and the running app, so <code>NEXT_PUBLIC_</code> values work.</li>
          </ul>
          <p>Build settings are auto-detected and can be overridden. See <a href="/docs#build">build settings</a>.</p>
        </section>

        <section id="deploy">
          <h2>Deploy in a few commands</h2>
          <p>Run these inside your Next.js project folder, using the 6-digit code emailed to you after <code>register</code>. The CLI uploads your source, EasyHost installs, builds and starts it.</p>
          <div class="code"><pre>npx ezhst register
npx ezhst verify &lt;code&gt;
npx ezhst link
npx ezhst deploy</pre></div>
          <p>Or let a coding agent do it. Run <code>npx ezhst skill install</code>, choose Global or Local, and tell Claude Code, Cursor or Codex to "deploy this to EasyHost". The <a href="/guides/deploy-nextjs-with-ai-agents">agent deploy guide</a> shows how to load the instructions and deploy.</p>
          <p>Your <code>.env</code> files are never uploaded. Import them once with <code>ezhst env import .env</code>.</p>
        </section>

        <section id="compare">
          <h2>How it compares to other free Next.js hosting</h2>
          <p>Free tiers differ more in shape than in size. This table uses each provider's own documentation as of September 2026: the <a href="https://vercel.com/docs/plans/hobby" rel="noopener">Vercel Hobby plan docs</a> and the <a href="https://render.com/docs/free" rel="noopener">Render free tier docs</a>.</p>
          <div class="table-wrap">
            <table>
              <thead><tr><th></th><th>EasyHost</th><th>Vercel Hobby</th><th>Render Free</th></tr></thead>
              <tbody>
                <tr><td>How Next.js runs</td><td>Always-on container</td><td>Serverless functions and a global CDN</td><td>Container that spins down after 15 minutes without traffic and takes about a minute to spin back up</td></tr>
                <tr><td>Usage limits</td><td>512 MB RAM and 1 CPU per app, 3 projects</td><td>100 GB data transfer, 1,000,000 function invocations and 4 CPU-hours per month</td><td>750 instance hours per month</td></tr>
                <tr><td>Postgres</td><td>Included, 1 per project</td><td>Not part of the plan (added through integrations)</td><td>Free database expires 30 days after creation, 1 GB</td></tr>
                <tr><td>Deploy from Git</td><td>No, CLI upload</td><td>Yes, with preview deployments</td><td>Yes</td></tr>
                <tr><td>Regions</td><td>One</td><td>Global edge network</td><td>One per service</td></tr>
              </tbody>
            </table>
          </div>
          <p>The short version: Vercel gives you the most polished Next.js platform and a worldwide CDN. Render gives you a general container host. EasyHost gives you one always-on Next.js container with a database and storage already attached. There is a longer write-up on the <a href="/vercel-alternative">Vercel alternative</a> page.</p>
        </section>

        <section id="tradeoffs">
          <h2>What EasyHost does not do</h2>
          <p>Free hosting always has trade-offs. These are ours, stated plainly so you can decide before you deploy.</p>
          <ul>
            <li>Node.js apps are supported, including Next.js and APIs.</li>
            <li>Apps run in one region. There is no edge network or CDN in front of them.</li>
            <li>There is no Git integration and there are no preview deployments. You deploy with the CLI.</li>
            <li>512 MB of RAM is enough for most Next.js apps, but not for heavy in-process workloads.</li>
            <li>Files in a storage bucket are public to anyone who has the URL.</li>
          </ul>
        </section>

        <section id="faq">
          <h2>Frequently asked questions</h2>
          <h3>Is there a catch to the free plan?</h3>
          <p>No trial and no card. The catch is the limits: 3 projects, 512 MB of RAM and 1 CPU per app, one region, and two apps per project.</p>
          <h3>Does a free Next.js app on EasyHost sleep when nobody visits?</h3>
          <p>No. The container keeps running, so there is no cold start after a period without traffic.</p>
          <h3>Can I host a full-stack Next.js app with a database for free?</h3>
          <p>Yes. Each project can have one <a href="/free-postgres-hosting">Postgres database</a> and one S3 compatible bucket alongside the app, all free.</p>
          <h3>Do I need to change my Next.js project to deploy it?</h3>
          <p>No. There is no adapter, config file or output mode to set. The project needs a <code>package.json</code> with <code>next</code> and a <code>build</code> script.</p>
        </section>

        <section id="start">
          <h2>Start for free</h2>
          <p>Install the skill, choose Global or Local, then tell your agent to deploy. No credit card, no config files.</p>
          <div class="code"><pre>npx ezhst skill install</pre></div>
          <div class="doc-cta">
            <a href="https://app.easyhost.fun/register" class="btn btn-primary">Sign up free</a>
            <a href="/docs" class="btn btn-outline">Read the docs</a>
          </div>
        </section>
      </main>
    </div>
    <Footer />
    <CopyCode />
</Base>
