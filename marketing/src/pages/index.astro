    <script is:inline>
      document.querySelectorAll("[data-copy]").forEach((button) => {
        button.addEventListener("click", () => {
          navigator.clipboard.writeText(button.dataset.copy).then(() => {
            button.classList.add("copied");
            setTimeout(() => {
              button.classList.remove("copied");
            }, 1500);
          });
        });
      });
    </script>
