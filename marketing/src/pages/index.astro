---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import NavLink from "../components/ui/NavLink.astro";
import Box from "../components/ui/Box.astro";
import Section from "../components/ui/Section.astro";
import Stack from "../components/ui/Stack.astro";
import Grid from "../components/ui/Grid.astro";
import Frame from "../components/ui/Frame.astro";
import Heading from "../components/ui/Heading.astro";
import Accent from "../components/ui/Accent.astro";
import Text from "../components/ui/Text.astro";
import SectionHead from "../components/ui/SectionHead.astro";
import Link from "../components/ui/Link.astro";
import InlineCode from "../components/ui/InlineCode.astro";
import Button from "../components/ui/Button.astro";
import Badge from "../components/ui/Badge.astro";
import Card from "../components/ui/Card.astro";
import FeatureCard from "../components/ui/FeatureCard.astro";
import MockWindow from "../components/ui/MockWindow.astro";
import AgentSession from "../components/ui/AgentSession.astro";
import Terminal from "../components/ui/Terminal.astro";
import CopyLine from "../components/ui/CopyLine.astro";
import Flow from "../components/ui/Flow.astro";
import LogoStrip from "../components/ui/LogoStrip.astro";
import LogoTile from "../components/ui/LogoTile.astro";
import Image from "../components/ui/Image.astro";
import NumberedList from "../components/ui/NumberedList.astro";
import NumberedItem from "../components/ui/NumberedItem.astro";
import PlanCard from "../components/ui/PlanCard.astro";
import FaqGrid from "../components/ui/FaqGrid.astro";
import AccordionItem from "../components/ui/AccordionItem.astro";
import IconTile from "../components/ui/IconTile.astro";
import CodeBlock from "../components/ui/CodeBlock.astro";
import { readTemplates } from "../seo/site.mjs";

const register = "https://app.reverhost.com/register";

const faqs = [
  {
    q: "Is Reverhost really free?",
    a: 'Yes, for hosting. Reverhost hosting costs $0 per month and signing up does not need a credit card. It is included within fixed <a href="#limits">limits</a>: 3 projects, and per project 2 apps, a 128 MB Postgres database and a 256 MB storage bucket. The AI Builder gives each account its first AI app and first build free. Pro ($10 a month) adds 10 projects and 500 AI tokens a month (see <a href="/pricing">pricing</a>).',
  },
  {
    q: "What can I host on Reverhost?",
    a: "Anything that runs in a container. Every app builds from a Dockerfile you keep on Reverhost, with ready templates for Node.js, Bun, Python, Go, Ruby, PHP, Rust and Zig. That covers Next.js, Nuxt, Express, NestJS, FastAPI, Django, Flask, Gin, Rails, Laravel, Axum and more. HTTP apps must listen on <code>0.0.0.0</code> and the assigned <code>PORT</code>.",
  },
  {
    q: "Do free apps go to sleep?",
    a: "No. Each app runs in its own always-on container with 256 MB of RAM and half a CPU. It is not stopped when idle, so there is no cold start on the first request.",
  },
  {
    q: "Which AI coding agents can deploy to Reverhost?",
    a: 'Any agent that can run shell commands. Run <code>npx ezhst skill install</code>, pick Claude Code, Codex or Cursor, then Global or Local. For any other agent, ask it to read the installed <code>SKILL.md</code> or <a href="/skill.md">https://reverhost.com/skill.md</a> before deploying. The <a href="/guides/deploy-nextjs-with-ai-agents">agent deploy guide</a> has the steps for each.',
  },
  {
    q: "Do I need to connect GitHub or change my project?",
    a: "No. <code>ezhst deploy</code> packages the project folder and uploads it, and there is no Git integration. The only thing an app needs is a Dockerfile, which you or your agent start from a template with <code>ezhst build dockerfile template</code>.",
  },
  {
    q: "Can I use my own domain?",
    a: 'Yes. Every project gets <code>https://&lt;name&gt;.easyhost.fun</code>, and you can add <a href="/docs#domains">custom domains</a> with <code>ezhst domains add</code>. HTTPS certificates are issued automatically once DNS is verified.',
  },
  {
    q: "How is Reverhost different from Vercel?",
    a: 'Vercel runs Next.js on serverless functions behind a global CDN. Reverhost runs each app as one always-on container in a single region and includes Postgres and S3 storage in the same free account, all scriptable by a coding agent through one CLI. Reverhost has no preview deployments, Git integration or edge network. Read the full <a href="/vercel-alternative">comparison</a>.',
  },
  {
    q: "Can I build an app without writing code?",
    a: 'Yes. Open the <a href="/products/ai-builder">AI Builder</a> in the dashboard, name your app and describe it. The AI asks a few questions, shows a plan, lets you pick a theme and builds a real Node.js app with Postgres and storage at its own address. Your first AI app and its first build are free; after that, AI requests use AI tokens, which come with Pro.',
  },
  {
    q: "Is the database a real Postgres?",
    a: 'Yes. Each project can have one Postgres 16 database with its own role, reachable over TLS with a standard connection string, plus a shadow database for <code>prisma migrate dev</code>. More on the <a href="/free-postgres-hosting">free Postgres hosting</a> page.',
  },
];

const plainText = (html: string) => {
  return html.replace(/<[^>]+>/g, "").replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&amp;/g, "&");
};

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://reverhost.com/#organization",
      name: "Reverhost",
      url: "https://reverhost.com/",
      logo: "https://reverhost.com/icon-512.png",
      email: "hello@reverhost.com",
      sameAs: ["https://www.npmjs.com/package/ezhst"],
    },
    {
      "@type": "WebSite",
      "@id": "https://reverhost.com/#website",
      name: "Reverhost",
      url: "https://reverhost.com/",
      publisher: { "@id": "https://reverhost.com/#organization" },
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://reverhost.com/#software",
      name: "Reverhost",
      url: "https://reverhost.com/",
      description: "Free hosting for apps in any language, built from a Dockerfile, with managed Postgres, S3 compatible storage and custom domains, operated through the ezhst CLI by AI coding agents.",
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Web, macOS, Linux, Windows",
      offers: { "@type": "Offer", price: 0, priceCurrency: "USD" },
      publisher: { "@id": "https://reverhost.com/#organization" },
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((item) => {
        return {
          "@type": "Question",
          name: item.q,
          acceptedAnswer: { "@type": "Answer", text: plainText(item.a) },
        };
      }),
    },
  ],
});

const sessionSteps = [
  { kind: "prompt" as const, text: "deploy this to Reverhost" },
  { kind: "say" as const, text: "I'll deploy it with the Reverhost CLI. Checking the login first." },
  { kind: "tool" as const, text: "ezhst whoami --json", output: ["Logged in as ada@example.com"] },
  { kind: "tool" as const, text: "ezhst projects create my-app --json", output: ["Created project my-app"] },
  { kind: "tool" as const, text: "ezhst db create main --json", output: ["Postgres database main is ready"] },
  { kind: "tool" as const, text: "ezhst env set DATABASE_URL=postgres://...", output: ["Saved DATABASE_URL"] },
  { kind: "tool" as const, text: "ezhst deploy --json", output: ["Uploaded, built, started"], running: "Deploying" },
  { kind: "done" as const, text: "Deployed. Your app is live at <strong>https://my-app.easyhost.fun</strong>" },
];

const agents = [
  { name: "Claude Code" },
  { name: "Codex" },
  { name: "Cursor" },
  { name: "Postgres 16" },
  { name: "S3 compatible storage" },
  { name: "Automatic HTTPS" },
];

const languages = [
  { id: "nodejs", name: "Node.js", meta: "Next.js, Express, NestJS" },
  { id: "bun", name: "Bun", meta: "Hono, Elysia" },
  { id: "python", name: "Python", meta: "FastAPI, Django, Flask" },
  { id: "go", name: "Go", meta: "Gin, Echo, Fiber" },
  { id: "ruby", name: "Ruby", meta: "Rails, Sinatra" },
  { id: "php", name: "PHP", meta: "Laravel, Symfony" },
  { id: "rust", name: "Rust", meta: "Axum, Actix Web" },
  { id: "zig", name: "Zig", meta: "std.http, Zap" },
];

const goTemplate = readTemplates().find((template) => template.id === "go");
if (!goTemplate) {
  throw new Error("The go Dockerfile template is missing");
}

---

<Base>
  <Fragment slot="head">
    <title>Reverhost: Free App Hosting Your AI Agent Can Deploy To</title>
    <meta name="description" content="Free hosting for Node.js, Bun, Python, Go, Ruby, PHP, Rust and Zig apps, with Postgres, S3 storage and custom domains. No credit card." />
    <link rel="canonical" href="https://reverhost.com/" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Reverhost" />
    <meta property="og:url" content="https://reverhost.com/" />
    <meta property="og:title" content="Reverhost: Free App Hosting Your AI Agent Can Deploy To" />
    <meta property="og:description" content="Deploy apps in Node.js, Python, Go, Rust and more from a Dockerfile, with Postgres and S3 storage included." />
    <meta property="og:image" content="https://reverhost.com/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Reverhost: free app hosting your AI agent can deploy to" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Reverhost: Free App Hosting Your AI Agent Can Deploy To" />
    <meta name="twitter:description" content="Deploy apps in Node.js, Python, Go, Rust and more from a Dockerfile, with Postgres and S3 storage included." />
    <meta name="twitter:image" content="https://reverhost.com/og.png" />
    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </Fragment>

  <Nav>
    <NavLink href="#agents">For agents</NavLink>
    <NavLink href="#languages">Languages</NavLink>
    <NavLink href="#limits">Limits</NavLink>
    <NavLink href="#faq">FAQ</NavLink>
    <NavLink href="/docs" keep>Docs</NavLink>
  </Nav>

  <Box as="main">
    <Section size="full" space="none">
      <Frame tone="tint">
        <Stack gap="lg" align="center" maxWidth="860px">
          <Badge tone="outline" size="md" icon="sparkles">Agent-first hosting. Free.</Badge>
          <Heading level={1} align="center">Free app hosting your AI agent can <Accent>deploy&nbsp;to</Accent>.</Heading>
          <Text size="lg" tone="muted" align="center" maxWidth="520px" balance>
            Your agent deploys the app, Postgres and storage. Any language, one CLI.
          </Text>
          <Stack direction="row" gap="sm" justify="center" wrap>
            <Button href="#agents" size="lg">Install the skill</Button>
            <Button href="/docs" variant="secondary" size="lg">Read the docs</Button>
          </Stack>
        </Stack>

        <AgentSession slot="media" title="claude ~/my-app" agent="Claude Code" cwd="~/my-app" steps={sessionSteps} />
      </Frame>
    </Section>

    <Section space="sm">
      <LogoStrip label="Built for the agents you already use" items={agents} />
    </Section>

    <Section id="agents">
      <Grid cols={2} tablet={1} gap="2xl" align="center">
        <Box radius="xl" clip relative padding="lg" tone="muted" border>
          <Box relative>
            <MockWindow title="Install the skill" tone="frosted">
              <Stack gap="lg">
                <Stack gap="xs">
                  <Text size="xs" tone="muted" uppercase weight="medium">In your project</Text>
                  <CopyLine command="npx ezhst skill install" />
                </Stack>
                <Stack gap="xs">
                  <Text size="xs" tone="muted" uppercase weight="medium">Then tell your agent</Text>
                  <CopyLine command="Deploy this to Reverhost" prompt=">" copyLabel="Copy prompt" />
                </Stack>
                <Stack direction="row" gap="xs" wrap>
                  <Badge tone="white" icon="bot">Claude Code</Badge>
                  <Badge tone="white" icon="bot">Codex</Badge>
                  <Badge tone="white" icon="bot">Cursor</Badge>
                  <Badge tone="green" icon="check">Global or Local</Badge>
                </Stack>
              </Stack>
            </MockWindow>
          </Box>
        </Box>
        <Stack gap="md">
          <Heading level={2}>Give your agent the <Accent>manual</Accent>.</Heading>
          <Text size="md" tone="muted">
            The Reverhost skill teaches your agent every <InlineCode>ezhst</InlineCode> command, when to use <InlineCode>--json</InlineCode>, and how to recover from a failed build. Install it once, then just ask.
          </Text>
          <Text size="sm" tone="muted">
            Pick Claude Code, Codex or Cursor, then Global for all projects or Local for this project. Add <InlineCode>--agent</InlineCode> and <InlineCode>--global</InlineCode> or <InlineCode>--local</InlineCode> to skip the prompts. If your agent does not discover the skill, ask it to read <Link href="/skill.md">/skill.md</Link>.
          </Text>
        </Stack>
      </Grid>
    </Section>

    <Section id="languages">
      <Stack gap="2xl">
        <SectionHead layout="split">
          <Fragment slot="title">Bring any <Accent>language</Accent>.</Fragment>
          <Fragment slot="text">Every app builds from its own Dockerfile. Start from a template, change what you need, deploy.</Fragment>
          <Fragment slot="actions">
            <Button href="/languages" variant="secondary">All languages</Button>
          </Fragment>
        </SectionHead>
        <Grid cols={4} tablet={2} mobile={1} gap="sm">
          {languages.map((language) => (
            <LogoTile name={language.name} src={`/languages/${language.id}.svg`} href={`/languages/${language.id}`} external={false} meta={language.meta} />
          ))}
        </Grid>
        <Grid cols={2} tablet={1} gap="2xl" align="center">
          <Stack gap="xl">
            <NumberedList>
              <NumberedItem title="Pick a template">
                <Text size="sm" tone="muted"><InlineCode>ezhst build dockerfile template go --apply</InlineCode></Text>
              </NumberedItem>
              <NumberedItem title="Make it yours">
                <Text size="sm" tone="muted">Change the base image, build and start command. Listen on <InlineCode>0.0.0.0:$PORT</InlineCode>.</Text>
              </NumberedItem>
              <NumberedItem title="Deploy">
                <Text size="sm" tone="muted"><InlineCode>ezhst deploy</InlineCode> uploads the folder, builds the image and runs it.</Text>
              </NumberedItem>
            </NumberedList>
            <Text size="sm" tone="muted">
              Environment variables reach the build as a secret and the container as plain env, never baked into the image. See the <Link href="/guides/write-a-dockerfile">Dockerfile guide</Link>.
            </Text>
          </Stack>
          <MockWindow title="Dockerfile" padding="none">
            <CodeBlock code={goTemplate.content.trim()} copy={false} />
          </MockWindow>
        </Grid>
      </Stack>
    </Section>

    <Section id="capabilities" tone="muted">
      <Stack gap="2xl">
        <SectionHead>
          <Fragment slot="title">The whole platform, one authenticated <Accent>CLI</Accent>.</Fragment>
          <Fragment slot="text">Every command takes <InlineCode>--json</InlineCode> and never prompts without a terminal, so agents get clean output and clear errors.</Fragment>
        </SectionHead>
        <Grid cols={3} gap="md">
          <FeatureCard title="Deploy anything" text="Package the folder, upload, build your Dockerfile and go live on its own subdomain." span={2}>
            <Box slot="visual" maxWidth="520px" style="width:100%">
              <Terminal
                title="ezhst deploy"
                tone="light"
                lines={[
                  { prompt: "$", text: "ezhst deploy", tone: "cmd" },
                  { prompt: "", text: "Uploading source", tone: "muted" },
                  { prompt: "", text: "Building image", tone: "muted" },
                  { prompt: "", text: "done  Uploaded, built, started", tone: "ok" },
                ]}
              />
            </Box>
            <InlineCode>ezhst deploy</InlineCode>
          </FeatureCard>
          <FeatureCard title="Create an account" text="Register, verify with the 6-digit code from your inbox and log in, all without a browser." icon="user-plus">
            <InlineCode>ezhst register --name --email --password</InlineCode>
          </FeatureCard>
          <FeatureCard title="Environment variables" text="Set, unset or import a whole .env file. Applied on the next deploy." icon="braces">
            <InlineCode>ezhst env set KEY=VALUE</InlineCode>
          </FeatureCard>
          <FeatureCard title="Dockerfile" text="Start from a language template or upload your own. Stored on the app and used for every deploy." icon="settings">
            <InlineCode>ezhst build dockerfile template rust --apply</InlineCode>
          </FeatureCard>
          <FeatureCard title="Logs and build logs" text="Read runtime logs and the full build log, so the agent can fix what broke." icon="terminal">
            <InlineCode>ezhst deployments log</InlineCode>
          </FeatureCard>
          <FeatureCard title="S3 storage" text="An S3 compatible bucket with public file URLs and its own keys." icon="hard-drive">
            <InlineCode>ezhst storage create uploads</InlineCode>
          </FeatureCard>
          <FeatureCard title="Custom domains" text="Add a hostname, get the DNS record to set, verify and get HTTPS." span={2}>
            <Stack slot="visual" gap="xs" maxWidth="420px" style="width:100%">
              <Card padding="sm">
                <Stack direction="row" justify="between" align="center" gap="sm">
                  <Stack direction="row" gap="xs" align="center">
                    <IconTile icon="globe" size="sm" tone="muted" />
                    <Text size="sm" weight="medium" mono>shop.example.com</Text>
                  </Stack>
                  <Badge tone="green" icon="lock">HTTPS</Badge>
                </Stack>
              </Card>
              <Card padding="sm">
                <Stack direction="row" justify="between" align="center" gap="sm">
                  <Stack direction="row" gap="xs" align="center">
                    <IconTile icon="link" size="sm" tone="muted" />
                    <Text size="sm" weight="medium" mono>my-app.easyhost.fun</Text>
                  </Stack>
                  <Badge tone="green" icon="check">Verified</Badge>
                </Stack>
              </Card>
            </Stack>
            <InlineCode>ezhst domains add shop.example.com</InlineCode>
          </FeatureCard>
          <FeatureCard title="Postgres" text="A managed database with a connection string and a shadow DB for Prisma." icon="database">
            <InlineCode>ezhst db query "select 1"</InlineCode>
          </FeatureCard>
          <FeatureCard title="Team members" text="Invite people to a project by email. Members manage everything in it." icon="users" span={2}>
            <InlineCode>ezhst members invite you@team.com</InlineCode>
          </FeatureCard>
        </Grid>
      </Stack>
    </Section>

    <Section id="how">
      <Stack gap="2xl">
        <SectionHead layout="split">
          <Fragment slot="title">From a folder to a live URL in one <Accent>sentence</Accent>.</Fragment>
          <Fragment slot="text">Install the skill once. After that, deploying is a single request to your agent.</Fragment>
          <Fragment slot="actions">
            <Button href="#agents">Install the skill</Button>
          </Fragment>
        </SectionHead>
        <Grid cols={2} tablet={1} gap="2xl" align="center">
          <Image src="/images/developer-portrait.jpg" alt="A developer working at a laptop" radius="xl" aspect="4/5" />
          <Stack gap="xl">
            <NumberedList>
              <NumberedItem title="Install the skill">
                <Text size="sm" tone="muted">Run <InlineCode>npx ezhst skill install</InlineCode>, pick your agent, then Global or Local.</Text>
              </NumberedItem>
              <NumberedItem title="Ask your agent">
                <Text size="sm" tone="muted">"Deploy this to Reverhost." It signs you up if needed, creates a project and sets the env vars your app uses.</Text>
              </NumberedItem>
              <NumberedItem title="It goes live">
                <Text size="sm" tone="muted">We build your Dockerfile and start the container. If a build fails, the agent reads the log, fixes the Dockerfile and redeploys.</Text>
              </NumberedItem>
            </NumberedList>
            <Card variant="frosted" padding="md">
              <Stack gap="md">
                <Text size="sm" tone="muted">
                  <Text as="strong" tone="default" weight="medium">Humans get a dashboard too.</Text> Manage projects, deployments, storage and databases from the browser, or describe an app to the <Link href="/products/ai-builder">AI Builder</Link> and watch it build the frontend and backend live.
                </Text>
                <Stack direction="row">
                  <Button href={register} variant="secondary">Open the dashboard</Button>
                </Stack>
              </Stack>
            </Card>
          </Stack>
        </Grid>
      </Stack>
    </Section>

    <Section id="limits" tone="frame">
      <Stack gap="2xl">
        <SectionHead layout="split">
          <Fragment slot="title">Start free. <Accent>Upgrade</Accent> when you grow.</Fragment>
          <Fragment slot="text">No credit card to start. Every project gets its own apps, Postgres database and storage bucket.</Fragment>
        </SectionHead>
        <Grid cols={2} gap="md">
          <PlanCard
            name="Free"
            price="$0"
            period="/ month"
            description="For side projects and trying things out."
            features={["3 projects", "2 apps per project", "128 MB Postgres per project", "256 MB storage per project", "10 team members per project", "First AI app and build free"]}
            cta={{ label: "Start for free", href: register }}
          />
          <PlanCard
            name="Pro"
            price="$10"
            period="/ month"
            tag="More projects"
            highlight
            description="For shipping more apps and building with AI."
            features={["10 projects", "2 apps per project", "128 MB Postgres per project", "256 MB storage per project", "10 team members per project", "500 AI Builder tokens every month"]}
            cta={{ label: "Get Pro", href: register }}
          />
        </Grid>
        <Card variant="muted" padding="md">
          <Stack gap="xs">
            <Text size="sm" tone="muted">
              <Text as="strong" tone="default" weight="medium">Every plan</Text>: 256 MB RAM and half a CPU per app, images up to 1 GB, 10 builds a day on Free and 50 on Pro, HTTPS and custom domains.
            </Text>
            <Text size="sm" tone="muted">
              Runs Node.js, Bun, Python, Go, Ruby, PHP, Rust and Zig apps. See <Link href="/free-nextjs-hosting">free Next.js hosting</Link>, the <Link href="/vercel-alternative">Vercel alternative</Link> or <Link href="/pricing">full pricing</Link>.
            </Text>
          </Stack>
        </Card>
      </Stack>
    </Section>

    <Section id="faq">
      <Stack gap="2xl">
        <SectionHead>
          <Fragment slot="title">Questions people ask before they <Accent>deploy</Accent>.</Fragment>
        </SectionHead>
        <FaqGrid>
          {faqs.map((item, position) => (
            <AccordionItem question={item.q} answerHtml={item.a} />
          ))}
          <Card variant="frosted" padding="sm">
            <Stack direction="row" justify="between" align="center" gap="sm" wrap>
              <Text size="md" weight="medium">Still have questions? We are happy to help.</Text>
              <Button size="sm" href="mailto:hello@reverhost.com">Email us</Button>
            </Stack>
          </Card>
        </FaqGrid>
      </Stack>
    </Section>
  </Box>

  <Footer
    text="One command to install the skill. One sentence to deploy."
    primary={{ label: "Get started", href: "/docs#quick-start" }}
    secondary={{ label: "Docs", href: "/docs" }}
  >
    <Fragment slot="title">Your agent already wrote the app. Let it <Accent>ship it</Accent>.</Fragment>
  </Footer>
</Base>
