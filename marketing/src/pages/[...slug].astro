---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import StartCta from "../components/ui/StartCta.astro";
import DocLayout from "../components/ui/DocLayout.astro";
import Toc from "../components/ui/Toc.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
import Heading from "../components/ui/Heading.astro";
import Text from "../components/ui/Text.astro";
import Prose from "../components/ui/Prose.astro";
import Box from "../components/ui/Box.astro";
import Stack from "../components/ui/Stack.astro";
import Accordion from "../components/ui/Accordion.astro";
import AccordionItem from "../components/ui/AccordionItem.astro";
import NavLink from "../components/ui/NavLink.astro";
import Grid from "../components/ui/Grid.astro";
import LogoTile from "../components/ui/LogoTile.astro";
import { inline, renderMarkdown } from "../seo/markdown.mjs";
import { absolute, jsonLd, SITE, sitePages, UPDATED_LABEL } from "../seo/site.mjs";

export const getStaticPaths = () => {
  return sitePages().map((page) => {
    return { params: { slug: page.path.slice(1) }, props: { page } };
  });
};

const { page } = Astro.props;
const { html, toc } = renderMarkdown(page.body);
const url = absolute(page.path);
const robots = "index, follow, max-image-preview:large, max-snippet:-1";
const tocItems = toc.map((item) => {
  return { href: `#${item.id}`, html: inline(item.title) };
});
if (page.faq.length > 0) {
  tocItems.push({ href: "#faq", html: "FAQ" });
}
---

<Base>
  <Fragment slot="head">
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    <link rel="canonical" href={url} />
    <link rel="alternate" type="text/markdown" href={`${page.path}.md`} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Reverhost" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    <meta property="og:image" content={`${SITE}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${SITE}/og.png`} />
    <script is:inline type="application/ld+json" set:html={jsonLd(page)} />
  </Fragment>
  <Nav>
    <NavLink href="/">Home</NavLink>
    <NavLink href="/frameworks">Frameworks</NavLink>
    <NavLink href="/guides">Guides</NavLink>
    <NavLink href="/docs" keep>Docs</NavLink>
  </Nav>

  <DocLayout>
    <Toc slot="aside" items={tocItems} />
    <Box class="doc-head">
      <Stack gap="md">
        <Breadcrumbs items={page.crumbs} />
        {page.icon && <img src={page.icon} alt="" width="48" height="48" decoding="async" />}
        <Heading level={1} size="xl" html={inline(page.h1)} />
        <Text size="lg" tone="muted" html={inline(page.lead)} />
        <Text size="sm" tone="subtle">Last updated {UPDATED_LABEL}</Text>
      </Stack>
    </Box>
    {
      page.tiles && (
        <Grid cols={4} tablet={4} mobile={2} gap="sm">
          {page.tiles.map((tile) => (
            <LogoTile name={tile.name} src={tile.src} href={tile.href} meta={tile.meta} external={false} />
          ))}
        </Grid>
      )
    }
    <Prose html={html} />
    {
      page.faq.length > 0 && (
        <Box as="section" id="faq" class="doc-section">
          <Stack gap="lg">
            <Heading level={2} size="lg">Frequently asked questions</Heading>
            <Accordion>
              {page.faq.map((item) => (
                <AccordionItem questionHtml={inline(item.q)} answerHtml={inline(item.a)} />
              ))}
            </Accordion>
          </Stack>
        </Box>
      )
    }
    <StartCta />
  </DocLayout>

  <Footer cta={false} />
</Base>
