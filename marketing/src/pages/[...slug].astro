---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import CopyCode from "../components/CopyCode.astro";
import { inline, renderMarkdown } from "../seo/markdown.mjs";
import { absolute, HELD_BACK_FAMILIES, jsonLd, SITE, sitePages, UPDATED_LABEL } from "../seo/site.mjs";

export const getStaticPaths = () => {
  return sitePages().map((page) => {
    return { params: { slug: page.path.slice(1) }, props: { page } };
  });
};

const { page } = Astro.props;
const { html, toc } = renderMarkdown(page.body);
const url = absolute(page.path);
let robots = "index, follow, max-image-preview:large, max-snippet:-1";
if (HELD_BACK_FAMILIES.has(page.family)) {
  robots = "noindex, follow";
}
const lastCrumb = page.crumbs.length - 1;
---

<Base>
  <Fragment slot="head">
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    <link rel="canonical" href={url} />
    <link rel="alternate" type="text/markdown" href={`${page.path}.md`} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Reverhost" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    <meta property="og:image" content={`${SITE}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${SITE}/og.png`} />
    <script is:inline type="application/ld+json" set:html={jsonLd(page)} />
  </Fragment>
  <Nav>
    <a href="/">Home</a>
    <a href="/frameworks">Frameworks</a>
    <a href="/guides">Guides</a>
    <a href="/docs" class="keep">Docs</a>
  </Nav>

  <div class="container docs">
    <aside class="toc">
      <p class="toc-title">On this page</p>
      <ol>
        {
          toc.map((item) => (
            <li>
              <a href={`#${item.id}`} set:html={inline(item.title)} />
            </li>
          ))
        }
        {
          page.faq.length > 0 && (
            <li>
              <a href="#faq">FAQ</a>
            </li>
          )
        }
      </ol>
    </aside>

    <main class="doc">
      <div class="doc-head">
        <ol class="crumbs" aria-label="Breadcrumb">
          {
            page.crumbs.map((crumb, position) => {
              if (position === lastCrumb) {
                return <li aria-current="page">{crumb.name}</li>;
              }
              return (
                <li>
                  <a href={crumb.path}>{crumb.name}</a>
                </li>
              );
            })
          }
        </ol>
        <h1 set:html={inline(page.h1)} />
        <p class="lead" set:html={inline(page.lead)} />
        <p class="doc-meta">Last updated {UPDATED_LABEL}</p>
      </div>
      <Fragment set:html={html} />
      {
        page.faq.length > 0 && (
          <section id="faq">
            <h2>Frequently asked questions</h2>
            {page.faq.map((item) => (
              <Fragment>
                <h3 set:html={inline(item.q)} />
                <p set:html={inline(item.a)} />
              </Fragment>
            ))}
          </section>
        )
      }
      <section id="start">
        <h2>Start for free</h2>
        <p>Install the skill, choose Global or Local, then tell your agent to deploy. No credit card, no config files.</p>
        <div class="code"><pre>npx ezhst skill install</pre></div>
        <div class="doc-cta">
          <a href="https://app.reverhost.com/register" class="btn btn-primary">Sign up free</a>
          <a href="/docs" class="btn btn-outline">Read the docs</a>
        </div>
      </section>
    </main>
  </div>

  <Footer />
  <CopyCode />
</Base>
