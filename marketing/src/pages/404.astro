---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
---

<Base>
  <Fragment slot="head">
    <title>Page not found | Reverhost</title>
    <meta name="robots" content="noindex" />
  </Fragment>
    <Nav login={false}>
          <a href="/">Home</a>
          <a href="/docs" class="keep">Docs</a>
    </Nav>
    <main class="section">
      <div class="container">
        <p class="eyebrow">404</p>
        <h1>This page does not exist.</h1>
        <p class="lead">The link may be old or mistyped. These are the pages people usually want.</p>
        <div class="hero-actions">
          <a href="/" class="btn btn-primary btn-lg">Home</a>
          <a href="/docs" class="btn btn-outline btn-lg">Docs</a>
          <a href="/free-nextjs-hosting" class="btn btn-outline btn-lg">Free Next.js hosting</a>
        </div>
      </div>
    </main>
</Base>
