---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import StartCta from "../../components/ui/StartCta.astro";
import NavLink from "../../components/ui/NavLink.astro";
import Section from "../../components/ui/Section.astro";
import Frame from "../../components/ui/Frame.astro";
import Stack from "../../components/ui/Stack.astro";
import Box from "../../components/ui/Box.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import Heading from "../../components/ui/Heading.astro";
import Accent from "../../components/ui/Accent.astro";
import Text from "../../components/ui/Text.astro";
import Link from "../../components/ui/Link.astro";
import InlineCode from "../../components/ui/InlineCode.astro";
import DocLayout from "../../components/ui/DocLayout.astro";
import Toc from "../../components/ui/Toc.astro";
import Table from "../../components/ui/Table.astro";
import Row from "../../components/ui/Row.astro";
import Cell from "../../components/ui/Cell.astro";
import CodeBlock from "../../components/ui/CodeBlock.astro";
import CopyLine from "../../components/ui/CopyLine.astro";
import CommandList from "../../components/ui/CommandList.astro";
import CommandRow from "../../components/ui/CommandRow.astro";
import Terminal from "../../components/ui/Terminal.astro";
import List from "../../components/ui/List.astro";
import ListItem from "../../components/ui/ListItem.astro";
import NumberedList from "../../components/ui/NumberedList.astro";
import NumberedItem from "../../components/ui/NumberedItem.astro";
import Accordion from "../../components/ui/Accordion.astro";
import AccordionItem from "../../components/ui/AccordionItem.astro";

const crumbs = [
  { name: "Reverhost", path: "/" },
  { name: "Deploy with an AI agent", path: "/guides/deploy-nextjs-with-ai-agents" },
];

const toc = [
  { href: "#short-answer", label: "Short answer" },
  { href: "#claude-code", label: "Claude Code" },
  { href: "#cursor-codex", label: "Cursor, Codex and others" },
  { href: "#what-happens", label: "What the agent runs" },
  { href: "#backend", label: "Database, storage, domains" },
  { href: "#failures", label: "When a build fails" },
  { href: "#ci", label: "CI and sandboxes" },
  { href: "#safety", label: "What the agent will not do" },
  { href: "#faq", label: "FAQ" },
];

const heroLines: { prompt: string; text: string; tone: "user" | "cmd" | "ok" }[] = [
  { prompt: "you", text: "Deploy this to Reverhost", tone: "user" },
  { prompt: "agent", text: "$ npx ezhst deploy --json", tone: "cmd" },
  { prompt: "", text: "https://<name>.easyhost.fun", tone: "ok" },
];

const firstDeployCode = `npx ezhst whoami --json
npx ezhst register --name "Ada" --email ada@example.com --password "..." --json
npx ezhst verify 123456 --json
npx ezhst projects create my-app --link --json
npx ezhst env import .env --json
npx ezhst build dockerfile template nextjs --json
npx ezhst build dockerfile set -f - --json <<'EOF'
FROM node:22-alpine AS build
...
EOF
npx ezhst deploy --json`;
---

<Base>
  <Fragment slot="head">
    <title>Deploy a Next.js App with Claude Code, Cursor or Codex | Reverhost</title>
    <meta name="description" content="Step by step: let Claude Code, Cursor or Codex deploy your Next.js app for free. Install one skill, say deploy, and the agent handles sign-up, env vars and builds." />
    <link rel="canonical" href="https://reverhost.com/guides/deploy-nextjs-with-ai-agents" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Reverhost" />
    <meta property="og:url" content="https://reverhost.com/guides/deploy-nextjs-with-ai-agents" />
    <meta property="og:title" content="Deploy a Next.js App with Claude Code, Cursor or Codex | Reverhost" />
    <meta property="og:description" content="Let Claude Code, Cursor or Codex deploy your Next.js app for free. Install one skill and say deploy." />
    <meta property="og:image" content="https://reverhost.com/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://reverhost.com/og.png" />
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "TechArticle",
            "headline": "How to deploy a Next.js app with Claude Code, Cursor or Codex",
            "description": "Step by step: let Claude Code, Cursor or Codex deploy your Next.js app for free. Install one skill, say deploy, and the agent handles sign-up, env vars and builds.",
            "url": "https://reverhost.com/guides/deploy-nextjs-with-ai-agents",
            "image": "https://reverhost.com/og.png",
            "datePublished": "2026-09-30",
            "dateModified": "2026-11-25",
            "author": {
              "@type": "Organization",
              "name": "Reverhost",
              "url": "https://reverhost.com/"
            },
            "publisher": {
              "@type": "Organization",
              "name": "Reverhost",
              "url": "https://reverhost.com/",
              "logo": "https://reverhost.com/icon-512.png"
            },
            "mainEntityOfPage": "https://reverhost.com/guides/deploy-nextjs-with-ai-agents"
          },
          {
            "@type": "BreadcrumbList",
            "itemListElement": [
              {
                "@type": "ListItem",
                "position": 1,
                "name": "Reverhost",
                "item": "https://reverhost.com/"
              },
              {
                "@type": "ListItem",
                "position": 2,
                "name": "Deploy with an AI agent",
                "item": "https://reverhost.com/guides/deploy-nextjs-with-ai-agents"
              }
            ]
          },
          {
            "@type": "FAQPage",
            "mainEntity": [
              {
                "@type": "Question",
                "name": "Can Claude Code deploy a Next.js app by itself?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Yes. With the Reverhost skill installed, Claude Code can register or log in, create a project, set environment variables, deploy and read build logs using the ezhst CLI."
                }
              },
              {
                "@type": "Question",
                "name": "Does this work with Cursor and Codex?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Yes. Run npx ezhst skill install and choose Global or Local. Both install into .agents/skills. If the agent does not discover the skill, ask it to read the installed SKILL.md or https://reverhost.com/skill.md."
                }
              },
              {
                "@type": "Question",
                "name": "Is it free to deploy this way?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Yes. Reverhost is free with fixed limits: 3 projects, 256 MB of RAM and 0.5 CPU per app, and no credit card."
                }
              },
              {
                "@type": "Question",
                "name": "Do I need an MCP server?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "No. The agent uses a normal command line tool through its shell. There is nothing to run in the background."
                }
              }
            ]
          }
        ]
      }
    </script>
  </Fragment>

  <Nav>
    <NavLink href="/">Home</NavLink>
    <NavLink href="/free-nextjs-hosting">Free hosting</NavLink>
    <NavLink href="/vercel-alternative">vs Vercel</NavLink>
    <NavLink href="/docs" keep>Docs</NavLink>
  </Nav>

  <Section size="full" space="none">
    <Frame padding="md">
      <Stack gap="md" align="center">
        <Breadcrumbs items={crumbs} />
        <Heading level={1} size="xl" align="center" maxWidth="860px" reveal={0}>How to <Accent>deploy</Accent> a Next.js app with Claude Code, Cursor or Codex</Heading>
        <Text size="lg" tone="muted" align="center" maxWidth="740px" balance reveal={1}>To have a coding agent deploy a Next.js app, give it a hosting CLI it can run without a browser and instructions for using it. On Reverhost that is one command, <InlineCode>npx ezhst skill install</InlineCode>, followed by one sentence: "Deploy this to Reverhost". The agent creates the account, sets environment variables, deploys and returns a live URL. It is free.</Text>
        <Box maxWidth="460px" reveal={2}>
          <CopyLine command="npx ezhst skill install" />
        </Box>
        <Text size="sm" tone="subtle" align="center">Last updated November 25, 2026</Text>
      </Stack>
      <Box slot="media" maxWidth="640px" class="is-centered">
        <Terminal title="your agent" lines={heroLines} />
      </Box>
    </Frame>
  </Section>

  <DocLayout>
    <Toc slot="aside" items={toc} />

    <Box as="section" id="short-answer" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">The short answer</Heading>
        <Box tone="white" border shadow radius="lg" padding="md">
          <NumberedList layout="stack">
            <NumberedItem><Text tone="muted">In your Next.js project, run <InlineCode>npx ezhst skill install</InlineCode> and choose Global or Local.</Text></NumberedItem>
            <NumberedItem><Text tone="muted">Tell your agent: <InlineCode>Deploy this to Reverhost</InlineCode>. If it does not discover the skill, ask it to read the installed <InlineCode>SKILL.md</InlineCode> first.</Text></NumberedItem>
            <NumberedItem><Text tone="muted">Open the URL it gives you: <InlineCode>https://&lt;name&gt;.easyhost.fun</InlineCode>.</Text></NumberedItem>
          </NumberedList>
        </Box>
        <Text tone="muted">You need Node.js with <InlineCode>npx</InlineCode> and a Next.js project that has a <InlineCode>build</InlineCode> script. You do not need a Git remote. Every app builds from a Dockerfile stored on the app, and the agent can start from the Node.js template for you.</Text>
      </Stack>
    </Box>

    <Box as="section" id="claude-code" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">Deploy with Claude Code</Heading>
        <Text tone="muted">Install the Reverhost instructions, then ask Claude Code to read the installed file before deploying.</Text>
        <CodeBlock code="npx ezhst skill install" />
        <Text tone="muted">Choose Local to create <InlineCode>.agents/skills/reverhost/SKILL.md</InlineCode> in the current project, or Global to create <InlineCode>~/.agents/skills/reverhost/SKILL.md</InlineCode>. Pass <InlineCode>--local</InlineCode> or <InlineCode>--global</InlineCode> to skip the prompt. You can commit a local install to share it with your team.</Text>
        <Text tone="muted">For a local install, ask:</Text>
        <CodeBlock code="Read .agents/skills/reverhost/SKILL.md, then deploy this to Reverhost." wrap />
        <Text tone="muted">For a global install, use <InlineCode>~/.agents/skills/reverhost/SKILL.md</InlineCode> in that prompt.</Text>
      </Stack>
    </Box>

    <Box as="section" id="cursor-codex" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">Deploy with Cursor, Codex or another agent</Heading>
        <Text tone="muted">Run the same installer and choose Global or Local. Both choices use <InlineCode>.agents/skills</InlineCode>. For an agent running the command without prompts, supply the scope explicitly:</Text>
        <CodeBlock code="npx ezhst skill install --local --json" />
        <Text tone="muted">Use <InlineCode>--global</InlineCode> instead of <InlineCode>--local</InlineCode> for all projects. If your agent does not discover the skill, ask it to read the installed <InlineCode>SKILL.md</InlineCode> or <Link href="/skill.md">https://reverhost.com/skill.md</Link> before deploying.</Text>
        <Text tone="muted">Then give the agent the same prompt. Any agent that can run shell commands can use the CLI, because every command accepts flags instead of interactive prompts.</Text>
      </Stack>
    </Box>

    <Box as="section" id="what-happens" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">What the agent actually runs</Heading>
        <Text tone="muted">A first deploy usually looks like this. Every command prints JSON on stdout, so the agent reads results instead of scraping text.</Text>
        <CodeBlock code={firstDeployCode} />
        <NumberedList layout="stack">
          <NumberedItem title="Check who is logged in"><Text tone="muted">If nobody is, the agent asks you for an email and password and registers or logs in. After registering, it asks for the 6-digit code emailed to you and runs <InlineCode>verify</InlineCode>, which is required before any other command.</Text></NumberedItem>
          <NumberedItem title="Create and link a project"><Text tone="muted">Each app has its own subdomain within the project. A <InlineCode>.reverhost.json</InlineCode> file records the link.</Text></NumberedItem>
          <NumberedItem title="Import environment variables"><Text tone="muted"><InlineCode>.env</InlineCode> files are never uploaded, so the agent imports them explicitly.</Text></NumberedItem>
          <NumberedItem title="Set a Dockerfile"><Text tone="muted">The agent prints the Node.js template, changes the last line to <InlineCode>next start -H 0.0.0.0 -p $PORT</InlineCode> and saves it to the app. A Dockerfile in your repository is only used once it is uploaded this way.</Text></NumberedItem>
          <NumberedItem title="Deploy"><Text tone="muted">The CLI packages the source (without <InlineCode>node_modules</InlineCode>, <InlineCode>.next</InlineCode>, <InlineCode>.git</InlineCode> and <InlineCode>.env*</InlineCode>), uploads it, and Reverhost builds the stored Dockerfile and starts the app.</Text></NumberedItem>
        </NumberedList>
        <Text tone="muted">A successful deploy returns the deployment id, the status <InlineCode>RUNNING</InlineCode> and the URL.</Text>
      </Stack>
    </Box>

    <Box as="section" id="backend" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">Ask for a database, storage or a domain</Heading>
        <Text tone="muted">The same skill covers the rest of the platform, so follow-up prompts work without more setup:</Text>
        <CommandList>
          <CommandRow command="Add a Postgres database and run my Prisma migrations">Runs <InlineCode>db create</InlineCode>, reads the connection string, sets <InlineCode>DATABASE_URL</InlineCode>, migrates and redeploys.</CommandRow>
          <CommandRow command="Store avatar uploads in a bucket">Runs <InlineCode>storage create</InlineCode> and sets the S3 endpoint, bucket and keys as env vars.</CommandRow>
          <CommandRow command="Put this on www.example.com">Runs <InlineCode>domains add</InlineCode>, tells you the DNS record to set, then verifies and issues HTTPS.</CommandRow>
        </CommandList>
        <Text tone="muted">The full command list is in the <Link href="/docs">docs</Link>.</Text>
      </Stack>
    </Box>

    <Box as="section" id="failures" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">When a build fails</Heading>
        <Text tone="muted">This is where an agent earns its keep. A failed deploy exits with code 1 and a JSON error, and the full build log is one command away:</Text>
        <CodeBlock code="npx ezhst deployments log --json" />
        <Text tone="muted">The agent reads the log, fixes the cause and deploys again. The common causes:</Text>
        <Table columns={["Symptom", "Fix"]}>
          <Row><Cell>An environment variable is missing at build time</Cell><Cell><InlineCode>ezhst env set KEY=VALUE</InlineCode>, then <InlineCode>ezhst redeploy</InlineCode></Cell></Row>
          <Row><Cell><InlineCode>npm ci</InlineCode> says the lockfile is out of sync</Cell><Cell>Delete <InlineCode>node_modules</InlineCode> and <InlineCode>package-lock.json</InlineCode>, run <InlineCode>npm install</InlineCode>, deploy again</Cell></Row>
          <Row><Cell>The app has no Dockerfile</Cell><Cell><InlineCode>ezhst build dockerfile template nextjs --apply</InlineCode>, then adjust it and <InlineCode>ezhst redeploy</InlineCode></Cell></Row>
          <Row><Cell>The app lives in a monorepo subfolder</Cell><Cell><InlineCode>ezhst build set --root-dir apps/web</InlineCode></Cell></Row>
          <Row><Cell>The project needs a different Node version</Cell><Cell>Change the <InlineCode>FROM</InlineCode> line in the stored Dockerfile and send it back with <InlineCode>ezhst build dockerfile set -f -</InlineCode>, then <InlineCode>ezhst redeploy</InlineCode></Cell></Row>
        </Table>
      </Stack>
    </Box>

    <Box as="section" id="ci" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">CI and agent sandboxes</Heading>
        <Text tone="muted">Where there is no saved login, such as a CI job or a cloud agent sandbox, pass a token in the environment instead:</Text>
        <CodeBlock code={"EZHST_TOKEN=<token> npx ezhst deploy --json"} />
        <Text tone="muted">Without a terminal the CLI never waits for input. If a value is missing it fails with a message naming the flag, which is what an agent needs to correct itself.</Text>
      </Stack>
    </Box>

    <Box as="section" id="safety" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">What the agent will not do on its own</Heading>
        <Box tone="white" border shadow radius="lg" padding="md">
          <List gap="md" divided>
            <ListItem icon="shield-check" tone="green">Destructive commands (<InlineCode>projects delete</InlineCode>, <InlineCode>storage delete</InlineCode>, <InlineCode>db delete</InlineCode>) require an explicit <InlineCode>--yes</InlineCode>, and the skill tells agents to run them only when you ask.</ListItem>
            <ListItem icon="lock" tone="green">The skill tells agents not to print passwords, keys or connection strings back to you, and to store them as environment variables instead.</ListItem>
            <ListItem icon="file-text" tone="green">Your <InlineCode>.env</InlineCode> files stay on your machine unless the agent imports them with <InlineCode>env import</InlineCode>.</ListItem>
          </List>
        </Box>
      </Stack>
    </Box>

    <Box as="section" id="faq" class="doc-section">
      <Stack gap="md">
        <Heading level={2} size="lg">Frequently asked questions</Heading>
        <Accordion>
          <AccordionItem question="Can Claude Code deploy a Next.js app by itself?">
            <Text tone="muted">Yes. With the Reverhost skill installed, Claude Code can register or log in, create a project, set environment variables, deploy and read build logs using the <InlineCode>ezhst</InlineCode> CLI.</Text>
          </AccordionItem>
          <AccordionItem question="Does this work with Cursor and Codex?">
            <Text tone="muted">Yes. Run <InlineCode>npx ezhst skill install</InlineCode> and choose Global or Local. Both install into <InlineCode>.agents/skills</InlineCode>. If the agent does not discover the skill, ask it to read the installed <InlineCode>SKILL.md</InlineCode> or <Link href="/skill.md">skill.md</Link>.</Text>
          </AccordionItem>
          <AccordionItem question="Is it free to deploy this way?">
            <Text tone="muted">Yes. Reverhost is free with fixed <Link href="/free-nextjs-hosting">limits</Link>: 3 projects, 256 MB of RAM and 0.5 CPU per app, and no credit card.</Text>
          </AccordionItem>
          <AccordionItem question="Do I need an MCP server?">
            <Text tone="muted">No. The agent uses a normal command line tool through its shell. There is nothing to run in the background.</Text>
          </AccordionItem>
        </Accordion>
      </Stack>
    </Box>

    <StartCta />
  </DocLayout>

  <Footer cta={false} />
</Base>
