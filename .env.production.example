POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
JWT_SECRET=
RESEND_API_KEY=

PORT=48710
DATABASE_URL=postgresql://easyhost:<POSTGRES_PASSWORD>@postgres:5432/easyhost
APP_URL=https://app.easyhost.fun

EMAIL_FROM="EasyHost <hello@easyhost.fun>"
EMAIL_DAILY_LIMIT=100

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=easyhost
MINIO_SECRET_KEY=<MINIO_ROOT_PASSWORD>
MINIO_DEPLOY_BUCKET=easyhost-deploys
MINIO_PUBLIC_ENDPOINT=storage.easyhost.fun
MINIO_PUBLIC_PORT=443
MINIO_PUBLIC_USE_SSL=true

SQLITE_DIR=/data/sqlite

CADDY_ADMIN_URL=unix:/run/caddy/admin.sock
APPS_DOMAIN=easyhost.fun
APPS_PROTOCOL=https
DOCKER_NETWORK=easyhost
BUILD_CONCURRENCY=1

VITE_PUBLIC_API_URL=https://api.easyhost.fun

PROXY_NETWORK=nginx-proxy-manager_default
