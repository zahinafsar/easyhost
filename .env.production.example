POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
USERDB_PASSWORD=
JWT_SECRET=
RESEND_API_KEY=

PORT=48710
DATABASE_URL=postgresql://easyhost:<POSTGRES_PASSWORD>@postgres:5432/easyhost
APP_URL=https://app.easyhost.fun

EMAIL_FROM="EasyHost <hello@easyhost.fun>"
EMAIL_DOMAIN=easyhost.fun
EMAIL_DAILY_LIMIT=100

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=easyhost
MINIO_SECRET_KEY=<MINIO_ROOT_PASSWORD>
MINIO_DEPLOY_BUCKET=easyhost-deploys
MINIO_PUBLIC_ENDPOINT=storage.easyhost.fun
MINIO_PUBLIC_PORT=443
MINIO_PUBLIC_USE_SSL=true

USERDB_URL=postgresql://postgres:<USERDB_PASSWORD>@userdb:5432/postgres
USERDB_PUBLIC_HOST=db.easyhost.fun
USERDB_PUBLIC_PORT=5432
USERDB_PUBLIC_SSLMODE=verify-full


CADDY_ADMIN_URL=unix:/run/caddy/admin.sock
APPS_DOMAIN=easyhost.fun
APPS_PROTOCOL=https
DOCKER_NETWORK=easyhost
BUILD_CONCURRENCY=1

VITE_PUBLIC_API_URL=https://api.easyhost.fun

PROXY_NETWORK=nginx-proxy-manager_default

NPM_LETSENCRYPT_DIR=<NPM_LETSENCRYPT_DIR>
USERDB_CERT_NAME=<USERDB_CERT_NAME>

PUBLIC_IP=65.181.123.115
EDGE_PROXY=npm
NPM_API_URL=http://nginx-proxy-manager_app_1:81
NPM_API_EMAIL=<NPM_API_EMAIL>
NPM_API_PASSWORD=<NPM_API_PASSWORD>
